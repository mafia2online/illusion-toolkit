<Project Sdk="Microsoft.NET.Sdk">

  <!-- Asset pipeline: adapts the Mafia format backend (Illusion.Formats) into the engine-neutral
       Domain model — game-folder discovery, SDS extraction, scene/mesh loading, material→texture
       resolution, catalogs, and the save/repack path. The only layer allowed to see both Formats
       and Domain; Rendering and the UI consume Domain types exclusively. -->

  <ItemGroup>
    <!-- The app sees the internals for one reason: the write-exclusivity probe has to be able to ask the Car
         aggregate how many files it has put bytes into. "The file changed and the aggregate did not write it"
         is the regression that seam decays into, and it cannot be measured from the outside. -->
    <InternalsVisibleTo Include="Illusion" />
  </ItemGroup>

  <ItemGroup>
    <!-- The names of the AREA volumes the game ships with (LoadZones.IsShipped): what is not on the list was
         added by somebody. -->
    <EmbeddedResource Include="World\ShippedLoadZones.txt" />
    <EmbeddedResource Include="World\ShippedInteriors.txt" />
    <EmbeddedResource Include="Materials\ShippedMaterials.bin" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Illusion.Domain\Illusion.Domain.csproj" />
    <ProjectReference Include="..\Illusion.Formats\Illusion.Formats.csproj" />
    <ProjectReference Include="..\Illusion.Bridge\Illusion.Bridge.csproj" />
  </ItemGroup>

</Project>
