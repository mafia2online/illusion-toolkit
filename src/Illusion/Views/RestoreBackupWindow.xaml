<Window x:Class="Illusion.Views.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        v:Density.ControlHeight="28"
        Title="Restore Backup"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- File → Restore Backup… (and the tree/viewport context menus): roll one loaded SDS archive back
         to a version from its "backups" folder (every Build adds one, so the very first version is the
         untouched stock archive). Confirming replaces the live game .sds AND its extracted mirror, then
         the scene reloads — MainWindow.PerformRestore does that part. Visual language comes from the
         shared EditorStyles dictionary: the ImportWindow shell (padded content over a hairline-topped
         command bar). -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- content -->
            <RowDefinition Height="Auto" />  <!-- command bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,20">
            <TextBlock Style="{StaticResource DimLabel}" Text="SDS" Margin="0,0,0,4" />
            <v:DropDownField x:Name="ArchiveBox" Margin="0,0,0,12" DisplayPath="Display"
                             SelectionChanged="Archive_Changed"
                             ToolTip="The loaded SDS archive to roll back" />

            <TextBlock Style="{StaticResource DimLabel}" Text="Backups (newest first)" Margin="0,0,0,4" />
            <Border BorderBrush="{StaticResource EdgeFaint}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="BackupList" Height="190" BorderThickness="0"
                             Background="Transparent"
                             ItemContainerStyle="{StaticResource PickerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="BackupList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding StampText}" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}" FontFamily="Consolas"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyLabel" Style="{StaticResource DimLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No backups yet — every Build saves one" Visibility="Collapsed" />
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}" BorderThickness="0,1,0,0"
                Padding="24,16">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DimLabel}" MaxWidth="280"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Replaces the game archive and its extracted files; the scene reloads" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource NeutralButton}" MinWidth="92" Margin="0,0,8,0"
                            Content="Cancel" Click="Cancel_Click" />
                    <Button x:Name="RestoreBtn" Style="{StaticResource AccentButton}" MinWidth="92"
                            Content="Restore" IsEnabled="False" Click="Restore_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
