<UserControl x:Class="Illusion.Views.PropertyList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views"
             xmlns:vm="clr-namespace:Illusion.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>

        <!-- ═══ Local styles: clone the app palette (window-scoped styles aren't visible here) ═══ -->
        <Style x:Key="LocalCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FillCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeFaint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <!-- Bottom 4, not 12: every row carries its own gap below (4 or 8), the last one included. -->
            <Setter Property="Padding" Value="12,12,12,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LocalCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LocalMetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="LocalMetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Dark input matching the Vector3Box cells (accent border on focus). -->
        <Style x:Key="LocalInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flags drop button: input-styled toggle showing the current summary + a chevron; opens the checkbox popup. -->
        <Style x:Key="LocalDropButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid Margin="8,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Content}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                           Text="&#xE70D;" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark row checkbox for the flags popup (a clean box + check, full-row hover). -->
        <Style x:Key="LocalFlagCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                        BorderBrush="{StaticResource EdgeStrong}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="Check" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Text="&#xE73E;" Foreground="{StaticResource TextPrimary}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource FillHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Row templates (one per PropertyKind / read-only state) ═══ -->

        <!-- One-line rows (read-only, numeric, bool, read-only flags) share one height, 24 — the field's — and a
             4 gap, so a card of mixed rows keeps one pitch. Multi-line blocks below sit 8 apart. -->
        <!-- Read-only "label … value" (Int / Float / Text / UInt64Hex / Bool). -->
        <DataTemplate x:Key="ReadOnlyRow">
            <Grid MinHeight="24" Margin="0,0,0,4" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource LocalMetaValue}" MaxWidth="150" />
            </Grid>
        </DataTemplate>

        <!-- Editable numeric / hex / text. -->
        <DataTemplate x:Key="NumericRow">
            <Grid MinHeight="24" Margin="0,0,0,4" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Style="{StaticResource LocalInput}" Text="{Binding Text}" />
            </Grid>
        </DataTemplate>

        <!-- Editable bool — a pill toggle switch. -->
        <DataTemplate x:Key="BoolRow">
            <Grid MinHeight="24" Margin="0,0,0,4" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" />
                <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BoolValue}" />
            </Grid>
        </DataTemplate>

        <!-- Editable hash-name: copyable name field + copyable read-only hash (auto-derived from the name;
             OneWay — HashHex has no setter). -->
        <DataTemplate x:Key="HashRow">
            <StackPanel Margin="0,0,0,8" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <v:CopyableTextField Label="{Binding Label}" Value="{Binding HashText}" />
                <v:CopyableTextField Label="Hash" Value="{Binding HashHex, Mode=OneWay}" ReadOnly="True" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Read-only hash-name: both fields copyable, non-editable. -->
        <DataTemplate x:Key="HashReadOnlyRow">
            <StackPanel Margin="0,0,0,8" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <v:CopyableTextField Label="{Binding Label}" Value="{Binding HashText, Mode=OneWay}" ReadOnly="True" />
                <v:CopyableTextField Label="Hash" Value="{Binding HashHex, Mode=OneWay}" ReadOnly="True" Margin="0,4,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Editable Vector3 — the reusable Vector3Box (with copy/paste, e.g. for Bounds). -->
        <DataTemplate x:Key="VectorRow">
            <v:Vector3Box Label="{Binding Label}" Decimals="3" ShowActions="True" Margin="0,0,0,8"
                          ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}"
                          X="{Binding VecX}" Y="{Binding VecY}" Z="{Binding VecZ}" />
        </DataTemplate>

        <!-- Editable flags: summary button + checkbox popup. -->
        <DataTemplate x:Key="FlagsRow">
            <StackPanel Margin="0,0,0,8" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" Margin="0,0,0,4" />
                <ToggleButton x:Name="FlagsBtn" Style="{StaticResource LocalDropButton}" Content="{Binding FlagsSummary}" />
                <Popup IsOpen="{Binding IsChecked, ElementName=FlagsBtn}" StaysOpen="False"
                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource PopupSurface}"
                            BorderBrush="{StaticResource EdgeNeutral}" BorderThickness="1"
                            CornerRadius="6" Padding="4" MaxHeight="300" MinWidth="150" Margin="0,4,8,8">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Flags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource LocalFlagCheck}" d:DataContext="{d:DesignInstance vm:FlagOptionViewModel}"
                                                  Content="{Binding Name}" IsChecked="{Binding IsSet}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </StackPanel>
        </DataTemplate>

        <!-- Read-only flags summary. -->
        <DataTemplate x:Key="FlagsReadOnlyRow">
            <Grid MinHeight="24" Margin="0,0,0,4" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding FlagsSummary}" Style="{StaticResource LocalMetaValue}" MaxWidth="190" />
            </Grid>
        </DataTemplate>

        <!-- Read-only 4×4 matrix. -->
        <DataTemplate x:Key="MatrixRow">
            <StackPanel Margin="0,0,0,8" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <TextBlock Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- Read-only expandable list of struct lines (arrays whose length fields make in-place editing unsafe). -->
        <DataTemplate x:Key="StructListRow">
            <Expander Margin="0,0,0,4" Foreground="{StaticResource TextSecondary}" ToolTip="{Binding Tooltip}" d:DataContext="{d:DesignInstance vm:PropertyRowViewModel}">
                <Expander.Header>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource LocalMetaLabel}" />
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Lines}" Margin="8,4,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>

        <v:PropertyRowTemplateSelector x:Key="RowSelector"
                                       ReadOnly="{StaticResource ReadOnlyRow}"
                                       Numeric="{StaticResource NumericRow}"
                                       Bool="{StaticResource BoolRow}"
                                       Hash="{StaticResource HashRow}"
                                       HashReadOnly="{StaticResource HashReadOnlyRow}"
                                       Vector="{StaticResource VectorRow}"
                                       Flags="{StaticResource FlagsRow}"
                                       FlagsReadOnly="{StaticResource FlagsReadOnlyRow}"
                                       Matrix="{StaticResource MatrixRow}"
                                       StructList="{StaticResource StructListRow}" />

        <!-- ═══ Group card templates ═══ -->
        <DataTemplate x:Key="KnownGroup">
            <Border Style="{StaticResource LocalCard}" d:DataContext="{d:DesignInstance vm:PropertyGroupViewModel}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource LocalCaption}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource RowSelector}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="UnknownGroup">
            <Border Style="{StaticResource LocalCard}" Padding="12" d:DataContext="{d:DesignInstance vm:PropertyGroupViewModel}">
                <Expander Foreground="{StaticResource TextMuted}" Header="{Binding HeaderText}">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource RowSelector}"
                                  Margin="0,8,0,0" />
                </Expander>
            </Border>
        </DataTemplate>

        <v:PropertyGroupTemplateSelector x:Key="GroupSelector"
                                         Known="{StaticResource KnownGroup}"
                                         Unknown="{StaticResource UnknownGroup}" />

    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Groups, RelativeSource={RelativeSource AncestorType={x:Type v:PropertyList}}}"
                  ItemTemplateSelector="{StaticResource GroupSelector}" />
</UserControl>
