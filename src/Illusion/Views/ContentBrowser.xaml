<UserControl x:Class="Illusion.Views.ContentBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:Illusion.Assets.Library;assembly=Illusion.Assets"
             xmlns:sds="clr-namespace:Illusion.Assets.Sds;assembly=Illusion.Assets"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- The library's navigator: the folder tree on the left, that folder's content as tiles on the right.
         A single click selects, a double click walks into a folder or puts an archive on the stage — the same
         split every asset browser has, so nothing here has to be learned.

         Two searches, because they answer two different questions. The one over the tree is "where in the
         game is this?" and queries the whole index; the one over the tiles is "which of THESE?" and narrows
         what is already on screen. Sorting sits beside the second one, since it reorders the same rows.

         There is no title bar and no status line. Everything one would have said is already on screen and
         better placed: which folder is open is the highlighted tree row, how much is in it is the number on
         that row, and what the tiles are is the tiles. A caption repeating them is a band of text charged
         against the height of a pane that is short to begin with.

         The fold is a tab OUTSIDE the block — it sits on the divider above, sticking up into the stage, so
         it stays put and stays clickable when the browser gives up all of its height. Folded, this control
         is one hairline; the tab is the whole of what is left. -->


    <UserControl.Resources>
        <v:ByteSizeConverter x:Key="ByteSize" />
        <v:ResourceGlyphConverter x:Key="Glyph" />
        <v:ResourceTintConverter x:Key="Tint" />

        <v:ArchiveGlyphConverter x:Key="ArchiveGlyph" />
        <v:ArchiveTintConverter x:Key="ArchiveTint" />
        <v:SectionTintConverter x:Key="SectionTint" />
        <v:SectionTitleConverter x:Key="SectionTitle" />
        <v:ResourceSizeConverter x:Key="ResourceSize" />


        <StreamGeometry x:Key="BrowserFolder">M1.5,9.3 L1.5,4.2 L4.4,4.2 L5.6,5.5 L10.5,5.5 L10.5,9.3 Z</StreamGeometry>
        <StreamGeometry x:Key="BrowserFind">M2.1,5.2 A3.1,3.1 0 1 1 8.3,5.2 A3.1,3.1 0 1 1 2.1,5.2 Z M7.5,7.5 L10.4,10.4</StreamGeometry>
        <!-- Up one level. A bare arrow, because at 13px it is the only thing that reads: a folder with an
             arrow inside it turns into a smudge, which was the first thing tried. -->
        <StreamGeometry x:Key="BrowserUpArrow">M6,10.4 L6,2.6 M2.4,6.2 L6,2.6 L9.6,6.2</StreamGeometry>

        <!-- Out of the open folder or archive. Sized to the sort field beside it so the row keeps one
             baseline; dimmed rather than hidden at a root, because a control that comes and goes moves
             everything next to it. -->
        <Style x:Key="BrowserUp" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Up one level" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Path x:Name="Icon" Width="13" Height="13" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{StaticResource TextStrong}" StrokeThickness="1.15" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource BrowserUpArrow}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Import: the same box as the Up button, widened for a label, because it is the one control in the
             row that CHANGES the archive rather than looking at it. Disabled outside an opened archive —
             there is nothing to import into while the pane is listing folders. -->
        <Style x:Key="BrowserAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1"
                                Padding="9,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The fold: a tab standing on the browser's top edge and sticking UP out of it, rounded on the
             top corners only and open at the bottom, so it reads as one piece with the pane it opens. The
             negative margin is what puts it outside; nothing between here and the window clips, so it draws
             and takes clicks over the divider and the bottom of the stage.
             Chevron down while the body is open (the way it will travel), up once it is folded away. -->
        <Style x:Key="BrowserHandle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-14,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource EdgeRaised}"
                                BorderThickness="1,1,1,0" CornerRadius="7,7,0,0" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Chev" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Text="&#xE70E;" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chev" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaisedHot}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeHot}" />
                                <Setter TargetName="Chev" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search field, matching the property panel's inputs. The left inset clears the magnifier. -->
        <Style x:Key="BrowserSearch" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="26,0,6,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Folder row: same chevron, hover and selection colours as the scene tree, so the two trees in the
             window read as one kind of thing. The root Grid is what the search hides — collapsing it takes the
             branch's children with it, which a hidden header alone would not. -->
        <Style x:Key="BrowserTreeItem" TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Row" Grid.Row="0" CornerRadius="3" Padding="2,0" MinHeight="23">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource FillHover}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- The scene tree's chevron, not a copy of it: the two trees sit in the
                                         same window and a row that indents by a different amount than the
                                         one above it is the kind of thing you see without being able to
                                         name. -->
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  Style="{StaticResource TreeChevron}"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Archive tile: a square of empty space with a big type icon in it, the name, and the size. An
             .sds is not opened to build this pane, so the icon is what a tile starts with; the archives that
             hold one figure — people, clothes — then get its picture, drawn in the background and kept on
             disk (see ArchiveThumb).
             No card: a hundred filled, outlined boxes read as a wall rather than as a hundred things, so the
             tile is nothing until the pointer or the selection is on it. What separates one from the next is
             the gap, not a border.
             100px with a 12px gap is measured, not taste: two rows of tile+gap have to clear the browser's
             opening height at 720p, where the host caps it at half the stage (see ResourceEditorWindow),
             once the panel's own 8px inset is off it. A row and a bit reads as a pane that failed to finish
             drawing. -->
        <Style x:Key="BrowserTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="100" Height="100" CornerRadius="8"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionFill}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The tab is a sibling of the pane, not a child of it: it has to survive the pane being collapsed to
         a hairline, and it is drawn last so it lands over the divider and the stage above. -->
    <Grid>
        <Border Background="{StaticResource SurfacePane}" BorderBrush="{StaticResource EdgeFaint}" BorderThickness="0,1,0,0">

            <!-- Body: folders | contents. Collapsed by the tab. -->
            <Grid x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FolderColumn" Width="218" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <!-- Left: the library search over the folder tree. Full width, above the tree it filters —
                     a box that narrows what is under it belongs on top of it, not in a far corner.
                     8 off every edge, like the scene panel next door: both are a search box over a tree in
                     the same window, and they have no business being inset differently. -->
                <Grid Grid.Column="0" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox" Style="{StaticResource BrowserSearch}"
                                 ToolTip="Search the whole library — folders and archives"
                                 TextChanged="Search_TextChanged" />
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource TextDim}"
                              StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource BrowserFind}" Margin="8,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search the library…" Foreground="{StaticResource TextFaint}"
                                   FontSize="11.5" Margin="28,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <!-- Not virtualized on purpose: the whole sds tree is well under a hundred folders, and
                         the search sets Visibility on the containers themselves — a recycled container would
                         carry the previous row's answer with it. -->
                    <TreeView x:Name="FolderTree" Grid.Row="1" BorderThickness="0" Background="Transparent"
                              ItemContainerStyle="{StaticResource BrowserTreeItem}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              VirtualizingStackPanel.IsVirtualizing="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type lib:LibraryFolder}" ItemsSource="{Binding Folders}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                          Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="0,0,7,0" SnapsToDevicePixels="True"
                                          Data="{Binding Resource, Converter={StaticResource Glyph}}"
                                          Stroke="{Binding Resource, Converter={StaticResource Tint}}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="11.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalEntries}" Foreground="{StaticResource TextFaint}"
                                               FontSize="10.5" VerticalAlignment="Center" Margin="8,0,2,0" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Splitter}" />

                <!-- Right: how the tiles are ordered, then what is filtered out of them, then the tiles. -->
                <Grid Grid.Column="2" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Out of here: back to the folder holding the open archive, or up to the parent
                             folder. First in the row because it is the one control that changes WHAT the
                             other two are working on. -->
                        <Button x:Name="UpBtn" Grid.Column="0" Style="{StaticResource BrowserUp}"
                                Margin="0,0,8,0" Click="Up_Click" />
                        <v:DropDownField x:Name="SortField" Grid.Column="1" Width="124" DisplayPath="Label"
                                         VerticalAlignment="Center" ToolTip="How the tiles are ordered"
                                         SelectionChanged="Sort_Changed" />
                        <Grid Grid.Column="2" Margin="8,0,0,0">
                            <TextBox x:Name="FilterBox" Style="{StaticResource BrowserSearch}"
                                     ToolTip="Narrow down what is showing in this folder"
                                     TextChanged="Filter_TextChanged" />
                            <Path Width="12" Height="12" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource TextDim}"
                                  StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource BrowserFind}" Margin="8,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock x:Name="FilterPlaceholder" Text="Filter this folder…" Foreground="{StaticResource TextFaint}"
                                       FontSize="11.5" Margin="28,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <!-- The one control in the row that changes the archive rather than the view of it,
                             so it stands at the far end, away from the three that only navigate. -->
                        <Button x:Name="ImportBtn" Grid.Column="3" Style="{StaticResource BrowserAction}"
                                Margin="8,0,0,0" Content="Import files…" Click="Import_Click"
                                ToolTip="Bring files from disk into this archive — or just drop them on the tiles" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="Contents" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource BrowserTile}"
                                 IsSynchronizedWithCurrentItem="False"
                                 SelectionMode="Extended"
                                 AllowDrop="True" DragOver="Contents_DragOver"
                                 DragLeave="Contents_DragLeave" Drop="Contents_Drop"
                                 MouseDoubleClick="Contents_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False">
                            <!-- Right-click on the tiles. Same shape as the scene tree's menu next door: the
                                 Opened handler stamps what is actually under the pointer onto the items
                                 before they show, so a menu never offers an action for a row you did not
                                 click. -->
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="ContentsContextMenu_Opened">
                                    <MenuItem x:Name="CopyItem" Header="Copy" InputGestureText="Ctrl+C"
                                              Click="Copy_Click" />
                                    <MenuItem x:Name="PasteItem" Header="Paste" InputGestureText="Ctrl+V"
                                              Click="Paste_Click" />
                                    <Separator />
                                    <MenuItem x:Name="DeleteItem" Header="Delete" InputGestureText="Del"
                                              Click="Delete_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ImportItem" Header="Import files…" Click="Import_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <!-- The tiles' own panel — and it stays the tiles' panel once the pane is banded
                                 by section, because ItemsPanel is the panel of the INNERMOST level. What
                                 lays the section blocks out is GroupStyle.Panel below; getting those two the
                                 wrong way round bands the pane sideways, one column per section. -->
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- Section band inside an opened archive. Unused while browsing folders: a view
                                 with no grouping never asks for it. The header carries the section's own
                                 colour, so a band is recognisable before its title is read. -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,9">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="3" Height="12" CornerRadius="1.5"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            Background="{Binding Name, Converter={StaticResource SectionTint}}" />
                                                    <TextBlock Foreground="White" FontSize="11.5"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Text="{Binding Name, Converter={StaticResource SectionTitle}}" />
                                                    <TextBlock Foreground="{StaticResource TextFaint}" FontSize="10.5"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Text="{Binding ItemCount}" />
                                                </StackPanel>
                                                <Border Height="1" Background="{StaticResource FillCard}" Margin="0,6,12,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>

                            <!-- Two implicit templates, picked by row type: the pane lists a folder's
                                 sub-folders above its archives, so a category that only gathers folders still
                                 opens onto something, and a double click walks into it. A sub-folder keeps the
                                 folder shape (tinted by what it holds) rather than taking its content's icon —
                                 in a grid of squares, "walks into it" and "goes on the stage" must not look
                                 alike. -->
                            <ListBox.Resources>
                                <DataTemplate DataType="{x:Type lib:LibraryFolder}">
                                    <Grid Margin="8,12,8,10" ToolTip="{Binding Path}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path Grid.Row="0" Width="40" Height="40" Stretch="Uniform"
                                              Fill="Transparent" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="{StaticResource BrowserFolder}"
                                              Stroke="{Binding Resource, Converter={StaticResource Tint}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White"
                                                   FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextFaint}" FontSize="10"
                                                   TextAlignment="Center" Margin="0,2,0,0"
                                                   Text="{Binding TotalEntries, StringFormat={}{0} archives}" />
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type lib:LibraryEntry}">
                                    <Grid Margin="8,12,8,10">
                                        <Grid.ToolTip>
                                            <!-- Where a hit came from: the tile has no room for the folder,
                                                 and while searching that is the one thing it needs to say. -->
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Name}" Foreground="White"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding FolderPath}" Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- The type icon, until the archive's picture arrives — and for good
                                             on the kinds that get none (see ArchiveThumbnailRenderer.Draws).
                                             The picture reaches out of the tile's inset: it is the content, a
                                             face at icon size says nothing. -->
                                        <Path x:Name="Glyph" Grid.Row="0" Width="40" Height="40" Stretch="Uniform"
                                              Fill="Transparent" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="{Binding Resource, Converter={StaticResource Glyph}}"
                                              Stroke="{Binding Resource, Converter={StaticResource Tint}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                                        <Border Grid.Row="0" Margin="-5,-9,-5,0" CornerRadius="5" ClipToBounds="True">
                                            <Image x:Name="Thumb" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   v:ArchiveThumb.Entry="{Binding}" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White"
                                                   FontSize="11" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextFaint}" FontSize="10"
                                                   TextAlignment="Center" Margin="0,2,0,0"
                                                   Text="{Binding Size, Converter={StaticResource ByteSize}}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Thumb" Property="Source" Value="{x:Null}">
                                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <!-- One resource inside an opened archive. Same square as an archive tile,
                                     so stepping in changes what you are looking at and not how to read it.
                                     The tooltip carries the engine's own type name — that is what the game
                                     and every other tool call it, and the section is only our grouping. -->
                                <DataTemplate DataType="{x:Type sds:SdsResource}">
                                    <Grid Margin="8,12,8,10">
                                        <Grid.ToolTip>
                                            <StackPanel MaxWidth="320">
                                                <TextBlock Text="{Binding Name}" Foreground="White"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid.ToolTip>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path Grid.Row="0" Width="40" Height="40" Stretch="Uniform"
                                              Fill="Transparent" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="{Binding Kind, Converter={StaticResource ArchiveGlyph}}"
                                              Stroke="{Binding Kind, Converter={StaticResource ArchiveTint}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White"
                                                   FontSize="11" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextFaint}" FontSize="10"
                                                   TextAlignment="Center" Margin="0,2,0,0"
                                                   Text="{Binding Converter={StaticResource ResourceSize}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>

                        <!-- Says why the pane is empty, which is otherwise indistinguishable from a stuck
                             browser. -->
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextFaint}" FontSize="11.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" Text="Pick a folder on the left" />

                        <!-- What a drag is over. Hit-test transparent, or the pane would stop receiving the
                             drag the moment the hint appeared under the pointer. -->
                        <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False"
                                Background="{StaticResource SelectionFill}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                                CornerRadius="6" Margin="-4">
                            <TextBlock x:Name="DropHintText" Foreground="White" FontSize="12.5"
                                       FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <ToggleButton x:Name="CollapseBtn" Style="{StaticResource BrowserHandle}"
                      IsChecked="True" ToolTip="Show / hide the content browser"
                      Checked="Collapse_Changed" Unchecked="Collapse_Changed" />
    </Grid>
</UserControl>
