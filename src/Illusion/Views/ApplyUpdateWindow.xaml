<Window x:Class="Illusion.Views.ApplyUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        v:Density.ControlHeight="28"
        Title="Illusion Toolkit"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <!-- The whole window of the updater process: the downloaded build, started out of its staging folder in
         apply mode (see UpdateInstaller), waiting for the toolkit to close so it can replace its files. It
         exists because the alternative is a gap with nothing on screen — the user pressed "Restart now", the
         window they were looking at vanished, and a silent second or two of file copying reads as a crash.
         Same composition as AppDialog: message band over a hairline-topped command bar, which stays hidden
         until there is a failure to act on. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,20">
            <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Installing the update" />
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" LineHeight="19"
                       Margin="0,4,0,0" Text="Waiting for the toolkit to close…" />
            <ProgressBar x:Name="Bar" Height="6" Margin="0,16,0,0" IsIndeterminate="True" />
        </StackPanel>

        <Border x:Name="Actions" Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="0,1,0,0" Padding="24,16" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Show the files" Style="{StaticResource NeutralButton}" Margin="0,0,8,0"
                        Click="ShowFiles_Click" />
                <Button Content="Close" Style="{StaticResource AccentButton}" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
