<Window x:Class="Illusion.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        v:Density.ControlHeight="28"
        Title="Import"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- File → Import…: bring a glTF file in. Each mesh routes by name prefix (COL_ → collision hull,
         anything else → render mesh) into the SDS archive picked below — only archives loaded in the
         scene are offered. Everything lands in front of the camera at the file's own scale. Visual
         language comes from the shared EditorStyles dictionary (same dark editor look as the material
         editor): padded content over a hairline-topped command bar. -->

    <Window.Resources>
        <!-- Type icons for the preview table — the scene tree's mesh cube / collision shield (~12×12),
             same geometry and stroke colors as MainWindow's hierarchy. -->
        <StreamGeometry x:Key="IconMesh">M6,1.5 L10.5,4 L10.5,8.5 L6,11 L1.5,8.5 L1.5,4 Z M1.5,4 L6,6.5 L10.5,4 M6,6.5 L6,11</StreamGeometry>
        <StreamGeometry x:Key="IconCollision">M6,1.5 L10,3 L10,6.2 C10,8.8 8.2,10.3 6,11 C3.8,10.3 2,8.8 2,6.2 L2,3 Z</StreamGeometry>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- content -->
            <RowDefinition Height="Auto" />  <!-- command bar -->
        </Grid.RowDefinitions>

        <!-- Labels sit ABOVE their fields — the property panel's row shape (label + input), not a
             two-column form. -->
        <StackPanel Grid.Row="0" Margin="24,20,24,20">
            <TextBlock Style="{StaticResource DimLabel}" Text="File" Margin="0,0,0,4" />
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Style="{StaticResource NeutralButton}"
                        MinWidth="0" Padding="12,0" Margin="8,0,0,0"
                        Content="Browse…" Click="Browse_Click" />
                <TextBox x:Name="FileBox" Style="{StaticResource DarkBox}" IsReadOnly="True" />
            </DockPanel>

            <TextBlock Style="{StaticResource DimLabel}" Text="SDS" Margin="0,0,0,4" />
            <v:DropDownField x:Name="TargetBox" Margin="0,0,0,12" DisplayPath="Display"
                             SelectionChanged="Target_Changed"
                             ToolTip="The loaded SDS archive the import lands in" />

            <!-- What the file contains, routed by name: COL_ prefixed meshes become collision hulls. -->
            <Border BorderBrush="{StaticResource EdgeFaint}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <ListView x:Name="PreviewList"
                          Height="150" BorderThickness="0"
                          Background="Transparent" Foreground="{StaticResource TextPrimary}" Focusable="False">
                    <ListView.ItemContainerStyle>
                        <!-- Flat, non-interactive rows: the Fluent ListViewItem template paints its own
                             bright hover/selection chrome, so replace the template outright. -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="Transparent" Padding="0,4">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource DarkColumnHeader}">
                            <GridViewColumn Header="Name" Width="130" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Type" Width="42">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Path Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center"
                                              Fill="Transparent" StrokeThickness="1.2" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              ToolTip="{Binding Type}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Mint}" />
                                                    <Setter Property="Data" Value="{StaticResource IconMesh}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Collision">
                                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Coral}" />
                                                            <Setter Property="Data" Value="{StaticResource IconCollision}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Materials" Width="130" DisplayMemberBinding="{Binding Materials}" />
                            <GridViewColumn Header="Note" Width="130" DisplayMemberBinding="{Binding Note}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <CheckBox x:Name="CreateMaterialsCheck"
                      FontSize="12" Foreground="{StaticResource TextPrimary}" IsChecked="True" Margin="0,8,0,0"
                      Visibility="Collapsed" Checked="Field_Changed" Unchecked="Field_Changed" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}" BorderThickness="0,1,0,0"
                Padding="24,16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource NeutralButton}" MinWidth="92" Margin="0,0,8,0"
                            Content="Cancel" Click="Cancel_Click" />
                    <Button x:Name="ImportBtn" Style="{StaticResource AccentButton}" MinWidth="92"
                            Content="Import" IsEnabled="False" Click="Import_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
