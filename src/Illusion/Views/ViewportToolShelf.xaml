<UserControl x:Class="Illusion.Views.ViewportToolShelf"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12">

    <!-- The viewport's own tools, Blender-style: what a drag does (select / move / rotate / scale) above the
         rule, and what the app is in below it (walk mode, Blender edit mode). Shared by both editor windows —
         a viewport is a viewport, and the tools that act on it have nothing to do with whether the content
         came from a district or off the library shelf. -->

    <Border Padding="5" Background="{StaticResource ScrimShelf}" CornerRadius="6">
        <StackPanel>
            <RadioButton x:Name="ToolSelect" GroupName="ViewportTool" IsChecked="True"
                         Style="{StaticResource ToolButton}" ToolTip="Select">
                <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource GlyphInk}"
                      Data="{StaticResource IconToolSelect}" />
            </RadioButton>
            <RadioButton x:Name="ToolMove" GroupName="ViewportTool" Margin="0,8,0,0"
                         Style="{StaticResource ToolButton}"
                         ToolTip="Move — while dragging: X/Y/Z locks an axis, Shift+X/Y/Z locks a plane, Shift snaps to steps, Ctrl slows it down for fine work">
                <Path Width="22" Height="22" Stretch="Uniform" Fill="Transparent"
                      Stroke="{StaticResource GlyphInk}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource IconToolMove}" />
            </RadioButton>
            <RadioButton x:Name="ToolRotate" GroupName="ViewportTool" Margin="0,8,0,0"
                         Style="{StaticResource ToolButton}"
                         ToolTip="Rotate — while dragging: X/Y/Z picks the axis to turn about, Shift snaps to 15°, Ctrl slows it down for fine work">
                <Path Width="22" Height="22" Stretch="Uniform" Fill="Transparent"
                      Stroke="{StaticResource GlyphInk}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource IconToolRotate}" />
            </RadioButton>
            <RadioButton x:Name="ToolScale" GroupName="ViewportTool" Margin="0,8,0,0"
                         Style="{StaticResource ToolButton}"
                         ToolTip="Scale — while dragging: X/Y/Z locks an axis, Shift+X/Y/Z locks a plane, Shift snaps to steps, Ctrl slows it down for fine work">
                <Path Width="22" Height="22" Stretch="Uniform" Fill="Transparent"
                      Stroke="{StaticResource GlyphInk}" StrokeThickness="1.3" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource IconToolScale}" />
            </RadioButton>

            <Border Height="1" Background="{StaticResource EdgeStrong}" Margin="4,10,4,0" />

            <!-- Below the rule sit the two MODE toggles — the ones that change what the app does rather than
                 which handle the gizmo shows. -->
            <ToggleButton x:Name="ToolWalk" Margin="0,10,0,0"
                          Style="{StaticResource ToolToggleButton}"
                          ToolTip="Walk mode (Space) — the keyboard flies the camera: WASD to move, Shift to cover ground, Ctrl to creep, middle drag to look. Off: the camera is mouse-only (middle drag orbits, Shift+middle pans, wheel zooms) and G / R / S move, rotate and scale the selection.">
                <Path Width="22" Height="22" Stretch="Uniform" Fill="{StaticResource GlyphInk}"
                      Stroke="{StaticResource GlyphInk}" StrokeThickness="2.1" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="{StaticResource IconToolWalk}" />
            </ToggleButton>

            <!-- Blender edit mode (Tab): the official Blender mark (see IconBlender). -->
            <ToggleButton x:Name="ToolBlender" Margin="0,8,0,0"
                          Style="{StaticResource BlenderToolButton}"
                          ToolTip="Edit the selection in Blender (Tab); click again to leave"
                          Click="BlenderTool_Click">
                <Path Width="24" Height="20" Stretch="Uniform" Fill="{StaticResource GlyphInk}"
                      Data="{StaticResource IconBlender}" />
            </ToggleButton>

            <!-- A new loading zone, made where the view looks. It goes with the Loading zones layer: enabled
                 while that layer is on, and not there at all on a stage that has no map. -->
            <StackPanel x:Name="ZoneTools">
                <Border Height="1" Background="{StaticResource EdgeStrong}" Margin="4,10,4,0" />
                <ToggleButton x:Name="ToolNewZone" Margin="0,10,0,0" IsEnabled="False"
                              Style="{StaticResource ToolToggleButton}" Checked="NewZone_Opened"
                              ToolTip="New loading zone - switch the Loading zones layer on (Layers) to use it">
                    <Path Width="22" Height="22" Stretch="Uniform" Fill="Transparent"
                          Stroke="{StaticResource GlyphInk}" StrokeThickness="1.3" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M1.6,1.6 L10.4,1.6 L10.4,10.4 L1.6,10.4 Z M6,3.7 L6,8.3 M3.7,6 L8.3,6" />
                </ToggleButton>
                <Popup x:Name="NewZonePopup" IsOpen="{Binding IsChecked, ElementName=ToolNewZone, Mode=TwoWay}" StaysOpen="False"
                       Placement="Right" PlacementTarget="{Binding ElementName=ToolNewZone}" HorizontalOffset="10"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource PopupSurface}" BorderBrush="{StaticResource EdgeNeutral}" BorderThickness="1"
                            CornerRadius="6" Padding="14,12" Width="300">
                        <StackPanel>
                            <TextBlock Text="New loading zone" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource DimLabel}" TextWrapping="Wrap" Margin="0,4,0,10"
                                       Text="A box is made where the view looks and picked; Move and Scale then put it in place. A zone loads its districts for a player who appears inside it only when it names two." />
                            <TextBlock Style="{StaticResource DimLabel}" Text="Name" Margin="0,0,0,3" />
                            <TextBox x:Name="NewZoneName" Padding="6,4" MaxLength="60" />
                            <TextBlock Style="{StaticResource DimLabel}" Text="Keeps loaded" Margin="0,10,0,3" />
                            <ComboBox x:Name="NewZoneDistrict1" />
                            <ComboBox x:Name="NewZoneDistrict2" Margin="0,6,0,0" />
                            <TextBlock x:Name="NewZoneRefusal" Foreground="#E08A6A" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="Collapsed" />
                            <Button Style="{StaticResource AccentButton}" Content="Create" Height="30" MinWidth="96"
                                    HorizontalAlignment="Right" Margin="0,12,0,0" Click="NewZone_Create" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
