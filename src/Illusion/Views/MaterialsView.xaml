<UserControl x:Class="Illusion.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views"
             xmlns:vm="clr-namespace:Illusion.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Local styles clone the app palette (window-scoped styles aren't visible here). -->
        <Style x:Key="MatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FillCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeFaint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FillActive}" />
                    <Setter Property="BorderBrush" Value="{StaticResource EdgeButton}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MatName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One material tile: the sphere thumbnail over the resolved dot + name. A click opens the
             material editor window (see OpenRequested in code-behind). -->
        <DataTemplate x:Key="MaterialTile">
            <Border Style="{StaticResource MatTile}" Cursor="Hand" MouseLeftButtonUp="Tile_Click"
                    d:DataContext="{d:DesignInstance vm:MaterialViewModel}">
                <Border.ToolTip>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding HashText}" FontFamily="Consolas" FontSize="11" />
                        <TextBlock Text="{Binding RangeText}" FontSize="11" />
                    </StackPanel>
                </Border.ToolTip>
                <StackPanel>
                    <!-- Full-width preview well (the thumbnail renders tile-shaped, so the sphere stays
                         whole). ImageBrush, not Image: UniformToFill on an Image crops from the top-left,
                         de-centering the sphere as the panel resizes — the brush crops around the center.
                         A null thumbnail leaves the dark well. -->
                    <Border Background="{StaticResource SurfaceInput}" CornerRadius="4" Height="92">
                        <Rectangle RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Border>
                    <Grid Margin="1,6,1,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource StatusWarn}" /> <!-- unresolved: amber -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Resolved}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusOk}" /> <!-- resolved: green -->
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource MatName}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 2×N tile grid — UniformGrid keeps exactly two columns and grows rows with the material count. -->
    <ItemsControl ItemsSource="{Binding Materials, RelativeSource={RelativeSource AncestorType={x:Type v:MaterialsView}}}"
                  ItemTemplate="{StaticResource MaterialTile}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
