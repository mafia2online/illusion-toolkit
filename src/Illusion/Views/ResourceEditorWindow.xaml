<Window x:Class="Illusion.Views.ResourceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        xmlns:vp="clr-namespace:Illusion.Viewport"
        Title="Resource Editor"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <!-- The library half of the toolkit, in its own window so the map editor keeps its own scene, camera and
         edits while you work on a car. Same parts as the map editor, arranged for one resource at a time:
         a stage instead of a district, the content browser under it instead of an area selector above it, and
         the very same scene panel on the right (see ScenePanel).
         The size floor matches the map editor's, and for the same reason — see MainWindow. -->

    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="0">
            <Menu.LayoutTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
            </Menu.LayoutTransform>
            <MenuItem Header="File">
                <MenuItem x:Name="SaveMenuItem" Header="Save" Command="{x:Static v:EditorCommands.Save}" />
                <MenuItem Header="Build SDS…" Click="Build_Click" />
                <MenuItem Header="Restore Backup…" Click="RestoreBackup_Click" />
                <Separator />
                <MenuItem x:Name="SettingsMenuItem" Header="Settings…"
                          Command="{x:Static v:EditorCommands.Settings}" />
                <Separator />
                <MenuItem Header="Close" Click="Close_Click" />
            </MenuItem>
            <MenuItem Header="Edit" SubmenuOpened="EditMenu_SubmenuOpened">
                <MenuItem x:Name="UndoMenuItem" Header="Undo" Command="{x:Static v:EditorCommands.Undo}" />
                <MenuItem x:Name="RedoMenuItem" Header="Redo" Command="{x:Static v:EditorCommands.Redo}" />
                <Separator />
                <!-- A geometry push rebuilds these by itself; the item is here for everything that does not
                     go through one, and for a car whose boxes were already stale when it was opened. -->
                <MenuItem x:Name="RebuildHitBoxesItem" Header="Rebuild hit boxes"
                          Click="RebuildHitBoxes_Click"
                          ToolTip="Recompute the selected model's per-piece hit boxes from its geometry, so new geometry can be shot" />
            </MenuItem>
            <!-- What used to be reachable only through the MCP server: each item opens a window over the same
                 job the matching tool does, so the menu and an agent cannot drift apart. -->
            <MenuItem Header="Tools">
                <MenuItem Header="Hide triangles in a box…" Click="HideTriangles_Click"
                          ToolTip="Hide the triangles of the selected mesh that lie inside a box, without rebuilding it" />
                <Separator />
                <MenuItem Header="Clone car…" Click="CloneCar_Click"
                          ToolTip="A second car under a new model name, registered in the tables and built" />
                <MenuItem Header="Replace a car…" Click="SubstituteCar_Click"
                          ToolTip="Build one car under another car's name; no table is touched" />
                <MenuItem Header="Export car for multiplayer…" Click="ExportCar_Click"
                          ToolTip="Write a built car out as a multiplayer resource folder" />
                <Separator />
                <MenuItem Header="Stream map…" Click="StreamMap_Click"
                          ToolTip="Find and replace in StreamMapa.bin - archive paths, line and group names" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Padding="0" ItemsPanel="{StaticResource StatusBarTwoColumns}">
            <StatusBarItem Grid.Column="0" Padding="6,1">
                <StackPanel Orientation="Horizontal">
                    <v:Vector3Box x:Name="CamPosBox" Compact="True" Decimals="2" VerticalAlignment="Center"
                                  Margin="2,1,0,1" ToolTip="Camera position (X, Y, Z)" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="10,1">
                <TextBlock x:Name="FpsText" VerticalAlignment="Center" FontFamily="Consolas" Opacity="0.85" Text="" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <!-- Stage column: toolbar · render surface · content browser. The browser is a row rather than an
                 overlay so it takes its height from the stage honestly, and it can fold away entirely — on a
                 1280x720 screen the height is the scarce thing. -->
            <Grid x:Name="StageColumn" Grid.Column="0" SizeChanged="StageColumn_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <!-- MaxHeight follows the column's height (StageColumn_SizeChanged): the browser may never
                         take more than half of what there is to split, however far the splitter is dragged.
                         The opening height is two rows of the browser's tiles plus its search bar — one and a
                         half rows of squares reads as a pane that failed to finish drawing.
                         No floor: the browser carries no caption to keep on screen, so folded it is a
                         hairline and the stage gets everything. Its tab hangs outside it and stays. -->
                    <RowDefinition x:Name="BrowserRow" Height="300" MinHeight="0" />
                </Grid.RowDefinitions>

                <v:ToolbarRowPanel x:Name="ToolbarRow" Grid.Row="0" Background="{StaticResource SurfaceBand}">
                    <!-- Left group: the Layers button, then what is on the stage right now. The browser below
                         is what CHANGES the stage, so the text says rather than asks.
                         ToolbarRowPanel lays out exactly THREE groups (left · centre · right), so everything
                         on this side has to live inside this one panel — a fourth child is never arranged. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- What is on the stage: the resource's own icon and its name. No "Stage" caption —
                         the browser below is what puts things here, so a word repeating that is a word doing
                         nothing, and the row reads as a title rather than as a label with a value.

                         The Layers button used to sit here. Its only entry was the collision overlay, and
                         that now lives on the Render tab where a car is worked on, so the button had nothing
                         left to open. -->
                    <Path x:Name="StagedIcon" Width="17" Height="17" Stretch="Uniform" VerticalAlignment="Center"
                          Margin="0,0,9,0" Fill="Transparent" Stroke="{StaticResource TextDim}"
                          StrokeThickness="1.2" StrokeLineJoin="Round" Visibility="Collapsed" />
                    <TextBlock x:Name="StagedText" Text="nothing loaded" Foreground="White" FontSize="13.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </StackPanel>

                    <!-- Centre action bar: the same Play · Multiplayer · Build as the map editor. Trying an
                         edit means starting the game, and which editor you happened to make it in is not a
                         reason to go looking for another window. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PlayBtn" Style="{StaticResource PlayButton}"
                                ToolTip="Launch Mafia II" Click="Play_Click" />
                        <Button x:Name="MultiplayerBtn" Style="{StaticResource ToolSquareButton}"
                                Content="&#xE774;" Margin="6,0,0,0"
                                ToolTip="Launch Multiplayer" Click="Multiplayer_Click" />
                        <Button x:Name="BuildBtn" Style="{StaticResource ToolSquareButton}"
                                Content="&#xE90F;" Margin="6,0,0,0"
                                ToolTip="Build — pack the edited archive back into its .sds"
                                Click="Build_Click" />
                    </StackPanel>

                    <!-- Right edge: shading mode, the same four as the map editor. -->
                    <v:CompactStrip x:Name="ModeStrip" VerticalAlignment="Center" Margin="0,4,12,4">
                        <v:CompactStrip.Items>
                            <RadioButton Tag="Render" GroupName="StageRenderMode"
                                         Style="{StaticResource RenderModeButton}"
                                         ToolTip="Render — full textures, normal &amp; specular maps"
                                         Checked="RenderMode_Changed">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="0.75" Canvas.Top="0.75" Width="14.5" Height="14.5" Fill="{StaticResource GlyphInk}" />
                                    <Path Fill="{StaticResource GlyphInkDim}">
                                        <Path.Data>
                                            <CombinedGeometry GeometryCombineMode="Exclude">
                                                <CombinedGeometry.Geometry1>
                                                    <EllipseGeometry Center="8,8" RadiusX="6.7" RadiusY="6.7" />
                                                </CombinedGeometry.Geometry1>
                                                <CombinedGeometry.Geometry2>
                                                    <EllipseGeometry Center="5.2,5.2" RadiusX="6.9" RadiusY="6.9" />
                                                </CombinedGeometry.Geometry2>
                                            </CombinedGeometry>
                                        </Path.Data>
                                    </Path>
                                </Canvas>
                            </RadioButton>
                            <RadioButton Tag="MaterialPreview" GroupName="StageRenderMode"
                                         Style="{StaticResource RenderModeButton}" IsChecked="True" Margin="4,0,0,0"
                                         ToolTip="Material Preview — diffuse texture only, no maps"
                                         Checked="RenderMode_Changed">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="0.75" Canvas.Top="0.75" Width="14.5" Height="14.5"
                                             Stroke="{StaticResource GlyphInk}" StrokeThickness="1.3" Fill="Transparent" />
                                    <Path Fill="{StaticResource GlyphInk}"
                                          Data="M8,1.5 L14.5,1.5 L14.5,8 L8,8 Z  M1.5,8 L8,8 L8,14.5 L1.5,14.5 Z">
                                        <Path.Clip>
                                            <EllipseGeometry Center="8,8" RadiusX="6.7" RadiusY="6.7" />
                                        </Path.Clip>
                                    </Path>
                                </Canvas>
                            </RadioButton>
                            <RadioButton Tag="Solid" GroupName="StageRenderMode"
                                         Style="{StaticResource RenderModeButton}" Margin="4,0,0,0"
                                         ToolTip="Solid — flat geometry, no textures" Checked="RenderMode_Changed">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="0.75" Canvas.Top="0.75" Width="14.5" Height="14.5" Fill="{StaticResource GlyphInk}" />
                                    <Ellipse Canvas.Left="3.6" Canvas.Top="3.2" Width="4.8" Height="4.8"
                                             Fill="White" Opacity="0.5" />
                                </Canvas>
                            </RadioButton>
                            <RadioButton Tag="Wireframe" GroupName="StageRenderMode"
                                         Style="{StaticResource RenderModeButton}" Margin="4,0,0,0"
                                         ToolTip="Wireframe — mesh edges" Checked="RenderMode_Changed">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="0.75" Canvas.Top="0.75" Width="14.5" Height="14.5"
                                             Stroke="{StaticResource GlyphInk}" StrokeThickness="1.15" Fill="Transparent" />
                                    <Ellipse Canvas.Left="5.3" Canvas.Top="0.75" Width="5.4" Height="14.5"
                                             Stroke="{StaticResource GlyphInk}" StrokeThickness="1.15" Fill="Transparent" />
                                    <Ellipse Canvas.Left="0.75" Canvas.Top="5.3" Width="14.5" Height="5.4"
                                             Stroke="{StaticResource GlyphInk}" StrokeThickness="1.15" Fill="Transparent" />
                                </Canvas>
                            </RadioButton>
                        </v:CompactStrip.Items>
                    </v:CompactStrip>
                </v:ToolbarRowPanel>

                <Grid Grid.Row="1">
                    <!-- Deferred on purpose: a window that opens on nothing to draw should not pay for a GPU
                         device, a shared render target and a per-frame callback to draw it. StageEntry starts
                         the viewport the first time there is something to put on it. -->
                    <vp:D3DImageHost x:Name="Stage" IsMapViewport="False" StartsOnDemand="True" />

                    <!-- What the window IS until then: the render surface is not running, so this is not an
                         overlay over a viewport, it is the whole of what the stage column shows. -->
                    <Border x:Name="EmptyStage" Background="{StaticResource StageBackdrop}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="76" Height="76" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{StaticResource StageGlyph}" StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource IconMesh}" HorizontalAlignment="Center" />
                            <TextBlock Text="Nothing on the stage" Foreground="{StaticResource TextSecondary}" FontSize="15"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Margin="0,24,0,0" />
                            <TextBlock Text="Double-click an archive below to open it" Foreground="{StaticResource TextGhost}"
                                       FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- The stage's third form: a texture is a picture, so the stage shows the picture. Same
                         page as the empty one so opening a texture reads as the stage changing rather than
                         as a different window; checkerboard behind it, because a texture with an alpha hole
                         and a texture that is simply dark look identical on a flat background. -->
                    <Border x:Name="TextureStage" Visibility="Collapsed" Background="{StaticResource StageFlat}">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{StaticResource EdgeRaised}" BorderThickness="1" SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle Fill="{StaticResource StageChecker}" />
                                    <Image x:Name="TextureImage" Stretch="Uniform"
                                           StretchDirection="DownOnly"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="TextureCaption" Grid.Row="1" Foreground="{StaticResource TextDim}"
                                       FontSize="11.5" HorizontalAlignment="Center" Margin="0,16,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>

                    <!-- The same tools and gizmos as the map editor: a viewport is a viewport. -->
                    <v:ViewportToolShelf x:Name="ToolShelf" />

                    <!-- Name of the helper glyph under the cursor; hidden until something is under it. -->
                    <v:GlyphHoverLabel x:Name="GlyphLabel" />

                    <!-- Blender edit-mode frame: an orange glow over the stage while a bridge session is
                         active. Purely visual (hit-test transparent). -->
                    <Border x:Name="BridgeFrame" BorderBrush="{StaticResource Blender}" BorderThickness="2.5"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource BlenderColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                    </Border>

                    <v:NoticeBanner x:Name="Notices" />
                </Grid>

                <GridSplitter x:Name="BrowserSplitter" Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource Splitter}" />

                <v:ContentBrowser x:Name="Browser" Grid.Row="3" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Splitter}" />

            <v:ScenePanel x:Name="Scene" Grid.Column="2"
                          HeaderHeight="{Binding ActualHeight, ElementName=ToolbarRow}" />
        </Grid>
    </DockPanel>
</Window>
