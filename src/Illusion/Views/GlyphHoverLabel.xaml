<UserControl x:Class="Illusion.Views.GlyphHoverLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             IsHitTestVisible="False" Visibility="Collapsed">

    <!-- The name of the glyph under the cursor. A helper node is a box or a pair of axes and nothing else on
         screen says which one it is — a car carries twenty dummies, and four of them are climb boxes. Shown
         on hover only: a permanent label per glyph would be the clutter this layer was written to avoid. -->

    <Border Background="{StaticResource ScrimTooltip}" CornerRadius="4" Padding="8,4">
        <TextBlock FontSize="12" TextOptions.TextFormattingMode="Display">
            <Run x:Name="NameRun" Foreground="{StaticResource TextPrimary}" />
            <Run x:Name="KindRun" Foreground="{StaticResource TextMuted}" />
        </TextBlock>
    </Border>
</UserControl>
