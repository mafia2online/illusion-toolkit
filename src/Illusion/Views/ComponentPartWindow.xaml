<Window x:Class="Illusion.Views.ComponentPartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        v:Density.ControlHeight="28"
        Title="Make damageable"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Component tree → right-click a bare component → Make damageable…
         Component tree → Add component…            (the same window, with the bone asked for as well)

         TWO questions and no more: what kind of part it is, and which component it hangs off. Everything
         else a deform part holds — the flag word, the crumple thresholds, the whole tuning block, the three
         copies of the parent link, and the half of the struct nobody has read — is derived from those two
         answers and from a measured template, and none of it is on this window.

         A component IS a bone, so adding one asks for the bone as well — and that is the ONLY difference
         between the two ways in. A bone that is already in the rig is given its part on the spot; one that
         is not is refused in the box below, because minting a bone is a writer that does not exist yet. When
         it lands, the refusal stops firing and nothing on this window moves.

         The paragraph above the questions is the OFFER: what the component gains by taking a part, said
         before the modder has to choose anything, because a bare component is a thing they have never had to
         think about having one. Same shell as ComponentCollisionWindow. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- content -->
            <RowDefinition Height="Auto" />  <!-- command bar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,20">

            <TextBlock x:Name="GainLabel" Style="{StaticResource DimLabel}" Margin="0,0,0,16"
                       TextWrapping="Wrap" />

            <!-- WHICH BONE. Shown only when a component is being added rather than a bare one given a part:
                 in that case the bone is the row the menu was opened on and there is nothing to ask. -->
            <StackPanel x:Name="BonePanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource DimLabel}" Text="Which bone" Margin="0,0,0,4" />
                <TextBox x:Name="BoneBox" Style="{StaticResource DarkBox}"
                         ToolTip="The bone this component is — the name it has in Blender." />
                <TextBlock x:Name="BoneHint" Style="{StaticResource DimLabel}" Margin="0,4,0,12"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- WHAT IT IS. Pre-filled with "normal", which is what a licence plate, a light and a wiper all
                 are: the kind that carries no other meaning. -->
            <TextBlock Style="{StaticResource DimLabel}" Text="What it is" Margin="0,0,0,4" />
            <v:DropDownField x:Name="KindBox" DisplayPath="Title" SelectionChanged="Kind_Changed"
                             ToolTip="The engine's own part kind. It decides the numbers the part starts with." />
            <TextBlock x:Name="KindHint" Style="{StaticResource DimLabel}" Margin="0,4,0,12"
                       TextWrapping="Wrap" />

            <!-- The parent, which is the nesting the tree shows and the link the file writes three times. -->
            <TextBlock x:Name="ParentCaption" Style="{StaticResource DimLabel}" Text="It hangs off"
                       Margin="0,0,0,4" />
            <v:DropDownField x:Name="ParentBox" DisplayPath="Title" SelectionChanged="Parent_Changed"
                             ToolTip="Which component this one belongs to — a window hangs off its door, a plate off the body." />
            <TextBlock x:Name="ParentHint" Style="{StaticResource DimLabel}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ErrorLabel" Foreground="{StaticResource StatusErrorText}" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="0,1,0,0" Padding="24,16">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="Trailer" DockPanel.Dock="Left" Style="{StaticResource DimLabel}"
                           MaxWidth="280" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="The bone and its geometry are not touched. Then Build." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource NeutralButton}" MinWidth="92" Margin="0,0,8,0"
                            Content="Cancel" Click="Cancel_Click" />
                    <Button x:Name="Accept" Style="{StaticResource AccentButton}" MinWidth="92"
                            Content="Give it a part" IsDefault="True" Click="Accept_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
