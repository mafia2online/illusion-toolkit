<UserControl x:Class="Illusion.Views.Vector3Box"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views"
             Language="en-US">
    <UserControl.Resources>
        <!-- Axis field: rounded dark cell with a colored X/Y/Z prefix (from Tag) and an accent border on focus. -->
        <Style x:Key="V3Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="{Binding Path=(v:Density.ControlHeight), RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Ax" Grid.Column="0"
                                           Text="{TemplateBinding Tag}" FontWeight="SemiBold" FontSize="11"
                                           Margin="8,0,4,0" VerticalAlignment="Center" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="X">
                                <Setter TargetName="Ax" Property="Foreground" Value="{StaticResource AxisX}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Y">
                                <Setter TargetName="Ax" Property="Foreground" Value="{StaticResource AxisY}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Z">
                                <Setter TargetName="Ax" Property="Foreground" Value="{StaticResource AxisZ}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Block-layout variant: shrinks freely (no min width) so three fields always fit the panel row. -->
        <Style x:Key="V3FieldBlock" TargetType="TextBox" BasedOn="{StaticResource V3Field}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Small flat icon button (copy / paste). -->
        <Style x:Key="V3IconBtn" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource EdgeSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Compact: everything on one row (label · X Y Z · paste · copy). For the status bar, where width is
             ample and vertical space is one line. -->
        <Grid x:Name="CompactRoot" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CompactLabel" Grid.Column="0" Foreground="{StaticResource TextSecondary}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="CompactX" Grid.Column="1" Tag="X" Style="{StaticResource V3Field}" />
            <TextBox x:Name="CompactY" Grid.Column="3" Tag="Y" Style="{StaticResource V3Field}" />
            <TextBox x:Name="CompactZ" Grid.Column="5" Tag="Z" Style="{StaticResource V3Field}" />
            <Button x:Name="CompactPaste" Grid.Column="7" Style="{StaticResource V3IconBtn}"
                    Content="&#xE77F;" ToolTip="Paste" />
            <Button x:Name="CompactCopy" Grid.Column="8" Style="{StaticResource V3IconBtn}"
                    Content="&#xE8C8;" ToolTip="Copy (X, Y, Z)" />
        </Grid>

        <!-- Block: label + paste/copy on top, the three fields span the full width below. Fits a narrow panel
             (fields share the whole row, so nothing is clipped even at the panel's minimum width). -->
        <Grid x:Name="BlockRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BlockLabel" Grid.Column="0" Foreground="{StaticResource TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button x:Name="BlockPaste" Grid.Column="1" Style="{StaticResource V3IconBtn}"
                        Content="&#xE77F;" ToolTip="Paste" />
                <Button x:Name="BlockCopy" Grid.Column="2" Style="{StaticResource V3IconBtn}"
                        Content="&#xE8C8;" ToolTip="Copy (X, Y, Z)" />
            </Grid>

            <!-- The gaps are columns of their own, so the three fields split what is left equally; a margin on
                 two of the three would hand the last one the gaps' width (97.7, 97.7, 101.7). -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="BlockX" Grid.Column="0" Tag="X" Style="{StaticResource V3FieldBlock}" />
                <TextBox x:Name="BlockY" Grid.Column="2" Tag="Y" Style="{StaticResource V3FieldBlock}" />
                <TextBox x:Name="BlockZ" Grid.Column="4" Tag="Z" Style="{StaticResource V3FieldBlock}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
