<Window x:Class="Illusion.Views.LoadZonesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        Title="Loading Zones"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Tools → Loading zones…: which zones of city_univers hold a point, what they make the game load there,
         and moving one face of a zone. The Loading zones layer draws the same volumes as boxes in the
         viewport; this window is where they are read and changed. Stays open beside the viewport. Visual
         language comes from the shared EditorStyles dictionary, like CrashObjectWindow. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,20">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <v:Vector3Box x:Name="PointBox" Grid.Column="0" Label="Point" Decimals="1" />
                <Button Grid.Column="1" Style="{StaticResource NeutralButton}" Height="28" Padding="12,0"
                        Margin="12,0,0,0" VerticalAlignment="Bottom" Content="Camera position"
                        ToolTip="Take the point from where the viewport camera stands"
                        Click="Camera_Click" />
            </Grid>

            <Border Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                <TextBlock x:Name="SummaryText" FontSize="12" Foreground="White" TextWrapping="Wrap" />
            </Border>

            <TextBlock Style="{StaticResource DimLabel}" Text="Zones at the point, and within 100 m of it"
                       Margin="0,0,0,4" />
            <Border BorderBrush="{StaticResource EdgeFaint}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="ZoneList" Height="210" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource PickerItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ZoneList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                               Foreground="White" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DistrictsText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11"
                                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyLabel" Style="{StaticResource DimLabel}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No zone here or near." Visibility="Collapsed" />
                </Grid>
            </Border>

            <TextBlock x:Name="ZoneText" Style="{StaticResource DimLabel}" TextWrapping="Wrap" Margin="0,10,0,10"
                       Text="Pick a zone to see its box and move a face." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FaceCombo" Grid.Column="0" DisplayMemberPath="Label" IsEnabled="False"
                          SelectionChanged="Face_Changed" ToolTip="Which face of the zone to move" />
                <TextBlock Grid.Column="1" Style="{StaticResource DimLabel}" VerticalAlignment="Center"
                           Margin="12,0,8,0" Text="to" />
                <TextBox x:Name="ToBox" Grid.Column="2" Padding="6,4" IsEnabled="False"
                         ToolTip="World coordinate the face moves to, on its own axis" />
                <Button x:Name="MoveBtn" Grid.Column="3" Style="{StaticResource AccentButton}" MinWidth="110"
                        Height="30" HorizontalAlignment="Right" Content="Move face…" IsEnabled="False"
                        Click="Move_Click" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource DimLabel}" MaxWidth="450"
                           TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="A district streams in where a zone naming two districts holds the player; a zone naming one does not load it by itself. A moved face is written to city_univers at once (no Undo - move it back), Build packs it, and every player of a server needs that archive." />
                <Button DockPanel.Dock="Right" Style="{StaticResource NeutralButton}" MinWidth="80" Height="32"
                        Content="Close" Click="Close_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
