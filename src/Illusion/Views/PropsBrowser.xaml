<UserControl x:Class="Illusion.Views.PropsBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- The props browser: the stock game's doors, furniture, plants and lamps, from every extracted interior,
         as tiles with a picture. Drag a tile onto the viewport to put the object where it lands, or double-click
         it to put it in front of the camera; it arrives in the loaded district with everything it needs.

         It sits under the map editor's viewport the way the content browser sits under the resource editor's
         stage, and is drawn from the same parts (EditorChrome): the shelves on the left where the folder tree
         is, the tiles on the right, a search over the list it narrows, the same tile, the same fold tab. Two
         editors that put things on a stage from a pane of tiles should not have to be learned twice. -->

    <UserControl.Resources>
        <!-- Shelf row: the content browser's folder row without its chevron — shelves do not nest. -->
        <Style x:Key="ShelfRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="4" Padding="8,0,2,0" MinHeight="24" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource FillHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SelectionFill}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The tab is a sibling of the pane, not a child of it: it has to survive the pane being collapsed to
         a hairline, and it is drawn last so it lands over the divider and the viewport above. -->
    <Grid>
        <Border Background="{StaticResource SurfacePane}" BorderBrush="{StaticResource EdgeFaint}" BorderThickness="0,1,0,0">

            <!-- Body: shelves | tiles. Collapsed by the tab. -->
            <Grid x:Name="Body">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="218" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <!-- Left: the search over the whole catalog, then the shelves. The counts on the shelves follow
                     the search, so it answers "which shelf is it on?" before a shelf is picked. -->
                <Grid Grid.Column="0" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox" Style="{StaticResource BrowserSearch}"
                                 ToolTip="Search the props by name, archive or shelf"
                                 TextChanged="Search_TextChanged" />
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource TextMuted}"
                              StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource BrowserFind}" Margin="8,0,0,0"
                              HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Search props" Foreground="{StaticResource TextMuted}"
                                   FontSize="12" Margin="28,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <ListBox x:Name="Shelves" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource ShelfRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Shelves_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                                          Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                                          Stroke="{StaticResource TextMuted}" Data="{StaticResource IconFolder}"
                                          VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=N0}" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0,2,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Splitter}" />

                <!-- Right: what is going on, what a placed prop brings, then the tiles. -->
                <Grid Grid.Column="2" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The catalog is read in the background the first time the pane is shown, and that
                             takes a while on a cold cache — this is where it says how far it got. -->
                        <TextBlock x:Name="Status" Grid.Column="0" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0"
                                   Text="Stock objects from the game's interiors" />
                        <TextBlock Grid.Column="1" Text="Collision" Foreground="{StaticResource TextSecondary}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <v:DropDownField x:Name="CollisionField" Grid.Column="2" Width="214" DisplayPath="Label"
                                         VerticalAlignment="Center"
                                         ToolTip="What collision a piece of scenery brings. Doors and physics props always bring their own." />
                        <!-- The one control in the row that does something rather than choosing, so it stands at
                             the far end — where the content browser keeps Import. -->
                        <Button Grid.Column="3" Style="{StaticResource BrowserAction}" Margin="8,0,0,0"
                                Content="Rescan" Click="Rescan_Click"
                                ToolTip="Scan the archives again (after extracting more of them)" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <!-- A wrapping panel cannot virtualize; the code-behind pages the list instead. -->
                        <ListBox x:Name="Tiles" BorderThickness="0" Background="Transparent"
                                 ItemContainerStyle="{StaticResource BrowserTile}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.ScrollChanged="Tiles_ScrollChanged"
                                 MouseDoubleClick="Tiles_MouseDoubleClick"
                                 PreviewMouseLeftButtonDown="Tiles_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="Tiles_PreviewMouseMove">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <!-- The content browser's archive tile: the picture once it is drawn (reaching out
                                     of the tile's inset — it is the content), a mesh glyph until then and for good
                                     on a prop that cannot be drawn. -->
                                <DataTemplate>
                                    <Grid Margin="8,12,8,8" ToolTip="{Binding ToolTip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Path x:Name="Glyph" Grid.Row="0" Width="40" Height="40" Stretch="Uniform"
                                              Fill="Transparent" StrokeThickness="1.5" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Stroke="{StaticResource TextMuted}" Data="{StaticResource IconMesh}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="Collapsed" />
                                        <Border Grid.Row="0" Margin="-5,-9,-5,0" CornerRadius="4" ClipToBounds="True">
                                            <Image x:Name="Thumb" Source="{Binding Thumbnail}" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="11" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding Detail}" Foreground="{StaticResource TextMuted}"
                                                   FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Says why the pane is empty, which is otherwise indistinguishable from a stuck one. -->
                        <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextMuted}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <ToggleButton x:Name="CollapseBtn" Style="{StaticResource BrowserHandle}"
                      IsChecked="True" ToolTip="Show / hide the props"
                      Checked="Collapse_Changed" Unchecked="Collapse_Changed" />
    </Grid>
</UserControl>
