<Window x:Class="Illusion.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Illusion Toolkit"
        Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <!-- Native Fluent dark (the app pins ThemeMode.Dark), like in MainWindow (map editor): no custom
         button outline, Segoe MDL2 glyphs, Consolas for paths, gray-alpha surfaces over the dark window.
         The two big tiles below are stock Fluent buttons — WPF's default template carries no accent brush
         at all, so hover and pressed are neutral fills, not the system accent. SizeToContent="Height" fits
         the height to the content — no empty gaps. -->

    <Window.Resources>
        <!-- The one control here that is NOT a native Fluent button: the settings gear in the corner. A
             Fluent button draws a filled surface, which beside the title reads as a second, competing
             element — and this is chrome, not one of the window's actions. So: no surface until the
             pointer is on it. -->
        <Style x:Key="CornerIconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillRest}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHot}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- The MCP server the whole application shares: its state on the left, its address on the
             right (click to copy). It runs from launch to exit, so this bar is the one place that
             can always answer "is it up, and where do I point a client at it?". The game path used
             to sit here; it is already on screen — in the path box, and in the ready card below. -->
        <StatusBar DockPanel.Dock="Bottom" Padding="0" ItemsPanel="{StaticResource StatusBarTwoColumns}">
            <StatusBarItem Grid.Column="0" Padding="8,1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="McpDot" Width="7" Height="7" VerticalAlignment="Center"
                             Margin="0,0,7,0" Fill="{StaticResource StatusWarn}" />
                    <TextBlock x:Name="McpStateText" FontFamily="Consolas" FontSize="11" Opacity="0.85"
                               VerticalAlignment="Center" Text="MCP starting…" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" Padding="10,1">
                <StackPanel x:Name="McpAddressPanel" Orientation="Horizontal" Background="Transparent"
                            MouseLeftButtonUp="McpAddress_Click">
                    <TextBlock x:Name="McpAddressText" FontFamily="Consolas" FontSize="11" Opacity="0.85"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"
                               Text="" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="24,20,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- title -->
                <RowDefinition Height="Auto" />   <!-- game folder selection -->
                <RowDefinition Height="Auto" />   <!-- status card (warn / ready / unpack) -->
                <RowDefinition Height="Auto" />   <!-- editor tiles -->
            </Grid.RowDefinitions>

            <!-- Title, with the settings gear pinned to the opposite corner: it belongs to the window rather
                 than to any row in it, and the top right is where a window's own controls are looked for. -->
            <!-- Two columns rather than one cell with an aligned overlay: the title takes what it needs and
                 the gear takes the corner, so no wording of the title can ever run underneath it. -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TitleBlock" Grid.Column="0" HorizontalAlignment="Left">
                    <TextBlock Text="Illusion Toolkit" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Mafia II / Mafia III resources" FontSize="12" Opacity="0.6" Margin="0,1,0,0" />
                </StackPanel>
                <!-- The negative right margin pulls the pair past the content inset, so they read as sitting in
                     the window's corner rather than in the text column. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            Margin="12,-2,-4,0">
                    <!-- Only ever visible when a check actually found a newer release. Green rather than the
                         chrome gray of the gear beside it: this is the one thing in the corner that is news,
                         and the launcher already uses the same green for the ready card's check. The colour is
                         a local value, so the hover trigger cannot repaint it white. -->
                    <Button x:Name="UpdateBtn" Style="{StaticResource CornerIconButton}"
                            Content="&#xE896;" Foreground="{StaticResource StatusOk}" Visibility="Collapsed"
                            Click="Update_Click" />
                    <Button x:Name="SettingsBtn" Style="{StaticResource CornerIconButton}"
                            Content="&#xE713;"
                            ToolTip="Settings — game folder, keymap, updates, Blender bridge, MCP server"
                            Click="Settings_Click" />
                </StackPanel>
            </Grid>

            <!-- Game folder: the first thing anyone has to set, so it is picked right here rather than one
                 window away. The value is the same setting the settings window edits (Settings → General) —
                 both write UserSettings.GamePath, and each re-reads it when the other has been in. -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock Text="Game folder" FontSize="12" Opacity="0.7" Margin="2,0,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Height="36" FontSize="13"
                             FontFamily="Consolas" VerticalContentAlignment="Center" Padding="8,0"
                             TextChanged="Path_TextChanged" />
                    <Button x:Name="BrowseBtn" Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0"
                            FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE8B7;" Padding="0"
                            ToolTip="Browse for the game folder (pc or install root)" Click="Browse_Click" />
                    <Button x:Name="UnpackBtn" Grid.Column="2" Width="36" Height="36" Margin="6,0,0,0"
                            FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE896;" Padding="0"
                            ToolTip="Unpack all game resources to \resources" Click="Unpack_Click" />
                </Grid>
            </StackPanel>

            <!-- Status card: exactly one panel is visible at a time. Gray 50% at a low
                 alpha — a surface that lifts off the dark window without a hard fill. -->
            <Border Grid.Row="2" Margin="0,0,0,22" CornerRadius="6"
                    Background="{StaticResource FillHairline}" BorderBrush="{StaticResource EdgeRaised}" BorderThickness="1"
                    Padding="12,10" MinHeight="52">
                <Grid VerticalAlignment="Center">

                    <!-- (a/b) invalid path or not yet unpacked -->
                    <StackPanel x:Name="WarnPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="18"
                                   Foreground="{StaticResource StatusWarn}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock x:Name="WarnText" FontSize="13" TextWrapping="Wrap"
                                   VerticalAlignment="Center" MaxWidth="470"
                                   Text="The game is not unpacked. Click the unpack button before opening the editors." />
                    </StackPanel>

                    <!-- (c) unpacked / ready — no progress bar or status line -->
                    <StackPanel x:Name="ReadyPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE930;" FontSize="20"
                                   Foreground="{StaticResource StatusOk}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Game is unpacked and ready" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReadyPathText" FontFamily="Consolas" FontSize="11"
                                       Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="470" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Work in progress — shown ONLY during an actual run (unpacking, or downloading an
                         update). Both are long, exclusive and worth watching, and the card is where the
                         launcher already says what it is doing. -->
                    <StackPanel x:Name="WorkPanel" VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressBar x:Name="WorkProgress" Height="6" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="WorkStatus" FontFamily="Consolas" FontSize="12" Opacity="0.8"
                                   Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editor tiles: native Fluent buttons (hover/pressed are neutral fills, not the system accent), stretched full width -->
            <UniformGrid Grid.Row="3" Rows="1" Columns="2" HorizontalAlignment="Stretch">
                <Button x:Name="MapEditorBtn" Height="140" Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False" Click="MapEditor_Click"
                        ToolTip="Open the 3D map editor">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE826;" FontSize="42"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Map Editor" FontSize="14" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ResourcesEditorBtn" Height="140" Margin="5,0,0,0"
                        HorizontalAlignment="Stretch"
                        IsEnabled="False" Click="ResourcesEditor_Click"
                        ToolTip="Open the resource editor — every archive in the game, one at a time on a stage">
                    <StackPanel>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F1;" FontSize="42"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Resource Editor" FontSize="14" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>
    </DockPanel>
</Window>
