<UserControl x:Class="Illusion.Views.DropDownField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The project's dropdown: the property panel's Flags row shape (input-styled toggle with a
         chevron, dark shadowed popup with picker rows) as a reusable field. Deliberately NOT a
         ComboBox — the Fluent theme reaches into ComboBox chrome, while this exact ToggleButton+Popup
         pattern is proven under it (the Object tab uses it live). -->

    <Grid>
        <ToggleButton x:Name="Btn" Style="{StaticResource DropButton}" Checked="Btn_Checked" />
        <Popup IsOpen="{Binding IsChecked, ElementName=Btn}" StaysOpen="False" Placement="Bottom"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Background="{StaticResource PopupSurface}" BorderBrush="{StaticResource EdgeNeutral}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="4" MaxHeight="300" Margin="0,4,8,8"
                    MinWidth="{Binding ActualWidth, ElementName=Btn}">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{StaticResource TextPrimary}" MaxHeight="290"
                         ItemContainerStyle="{StaticResource PickerItem}"
                         IsSynchronizedWithCurrentItem="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="List_SelectionChanged"
                         PreviewMouseLeftButtonUp="List_MouseUp" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
