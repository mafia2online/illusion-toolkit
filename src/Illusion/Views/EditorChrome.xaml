<!-- The v: prefix is declared for the binding PATHS below — (v:TabIcon.Icon). WPF resolves those even without
     it (measured: the icons draw either way), but a prefix nothing declares is one every reader and every
     analyser has to guess at. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Illusion.Views">

    <!-- Chrome shared by every window that edits a loaded archive: the scene tree's type icons and row
         controls, the toolbar and tool-shelf buttons, the property-panel cards and inputs. It used to live in
         MainWindow, which was fine while the map editor was the only editor; the resource editor and the
         scene panel need the same look, and a second copy of a style is a second thing to keep in step.
         Order matters: StaticResource cannot forward-reference within a dictionary. -->

        <!-- Vector icon geometries (defined first: StaticResource can't forward-reference within a dictionary).
             Blender-style resource-type icons (~12×12) for the scene tree, selected per node Kind. -->
        <StreamGeometry x:Key="IconFolder">M1.5,9.3 L1.5,4.2 L4.4,4.2 L5.6,5.5 L10.5,5.5 L10.5,9.3 Z</StreamGeometry>
        <StreamGeometry x:Key="IconArchive">M2,3.3 L10,3.3 L10,9.6 L2,9.6 Z M2,5.4 L10,5.4 M5.4,7.4 L6.6,7.4</StreamGeometry>
        <StreamGeometry x:Key="IconScene">M6,1.8 L10.6,4.6 L6,7.4 L1.4,4.6 Z M2.3,6.2 L6,8.5 L9.7,6.2</StreamGeometry>
        <StreamGeometry x:Key="IconMesh">M6,1.5 L10.5,4 L10.5,8.5 L6,11 L1.5,8.5 L1.5,4 Z M1.5,4 L6,6.5 L10.5,4 M6,6.5 L6,11</StreamGeometry>
        <StreamGeometry x:Key="IconLight">M4.3,6 A1.7,1.7 0 1 1 7.7,6 A1.7,1.7 0 1 1 4.3,6 Z M6,1.3 L6,2.6 M6,9.4 L6,10.7 M1.3,6 L2.6,6 M9.4,6 L10.7,6 M2.7,2.7 L3.6,3.6 M8.4,8.4 L9.3,9.3 M9.3,2.7 L8.4,3.6 M3.6,8.4 L2.7,9.3</StreamGeometry>
        <StreamGeometry x:Key="IconCamera">M1.5,4 L6.8,4 L6.8,8.5 L1.5,8.5 Z M6.8,5.4 L10.5,3.9 L10.5,8.6 L6.8,7.1</StreamGeometry>
        <StreamGeometry x:Key="IconCollision">M6,1.5 L10,3 L10,6.2 C10,8.8 8.2,10.3 6,11 C3.8,10.3 2,8.8 2,6.2 L2,3 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEmpty">M6,2 L6,10 M2,6 L10,6</StreamGeometry>
        <!-- A triangle with a bang: what the toolkit could not make sense of. Stroked like the tree's icons,
             so a faulted component row carries it beside its kind glyph at the same weight. -->
        <StreamGeometry x:Key="IconWarning">M6,1.6 L11,10.4 L1,10.4 Z M6,4.6 L6,7.4 M6,8.9 L6,9.1</StreamGeometry>
        <!-- Toolbar layer icons (12×12, stroked like the tree's). Each says what the layer IS, so the row reads
             without its label: a stack of sheets (the Layers button), a district grid, scattered instances, and
             a route through waypoints. Collisions reuse the tree's shield (IconCollision) — same thing, same
             icon. These replaced Segoe MDL2 glyphs that were only loosely about their layer, and one literal
             "▦" character. -->
        <StreamGeometry x:Key="IconLayers">M6,1.4 L11,4 L6,6.6 L1,4 Z M1,6.4 L6,9 L11,6.4 M1,8.8 L6,11.4 L11,8.8</StreamGeometry>
        <StreamGeometry x:Key="IconZones">M1.6,1.6 L10.4,1.6 L10.4,10.4 L1.6,10.4 Z M6,1.6 L6,10.4 M1.6,6 L10.4,6</StreamGeometry>
        <StreamGeometry x:Key="IconInstances">M1.4,7.4 L4.4,7.4 L4.4,10.4 L1.4,10.4 Z M4.9,1.6 L7.9,1.6 L7.9,4.6 L4.9,4.6 Z M7.6,6.4 L10.6,6.4 L10.6,9.4 L7.6,9.4 Z</StreamGeometry>
        <StreamGeometry x:Key="IconNavigation">M2.6,9.4 L5.4,6.2 L7.4,8.2 L10,3.4 M1.3,10.4 A1.3,1.3 0 1 1 3.9,10.4 A1.3,1.3 0 1 1 1.3,10.4 Z M8.8,2.6 A1.3,1.3 0 1 1 11.4,2.6 A1.3,1.3 0 1 1 8.8,2.6 Z</StreamGeometry>
        <!-- What the area selector and the season switch load (12×12, same stroke). They replaced the text
             characters "▦", "⌂" and "❄", which came from whatever font had them and sat off the toolbar's line:
             a district is a folded map, an interior a house, winter a snowflake. -->
        <StreamGeometry x:Key="IconDistrict">M1.4,2.8 L4.4,1.6 L7.6,2.8 L10.6,1.6 L10.6,9.2 L7.6,10.4 L4.4,9.2 L1.4,10.4 Z M4.4,1.6 L4.4,9.2 M7.6,2.8 L7.6,10.4</StreamGeometry>
        <StreamGeometry x:Key="IconInterior">M1.4,5.8 L6,1.8 L10.6,5.8 M2.8,4.6 L2.8,10.4 L9.2,10.4 L9.2,4.6 M5,10.4 L5,7.4 L7,7.4 L7,10.4</StreamGeometry>
        <StreamGeometry x:Key="IconWinter">M6,1 L6,11 M1.67,3.5 L10.33,8.5 M1.67,8.5 L10.33,3.5 M4.7,1.6 L6,3 L7.3,1.6 M4.7,10.4 L6,9 L7.3,10.4 M9.16,2.67 L8.6,4.5 L10.46,4.93 M2.84,9.33 L3.4,7.5 L1.54,7.07 M10.46,7.07 L8.6,7.5 L9.16,9.33 M1.54,4.93 L3.4,4.5 L2.84,2.67</StreamGeometry>
        <!-- Keymap row buttons: unbind (a cross) and back-to-default (an arrow turning back). -->
        <StreamGeometry x:Key="IconUnbind">M3,3 L9,9 M9,3 L3,9</StreamGeometry>
        <StreamGeometry x:Key="IconResetKey">M1.5,6 A4.5,4.5 0 1 0 6,1.5 A4.875,4.875 0 0 0 2.63,2.87 L1.5,4 M1.5,1.5 L1.5,4 L4,4</StreamGeometry>

        <!-- Eye toggle icons (~16×16): open eye with pupil / closed lid with lashes. -->
        <StreamGeometry x:Key="IconEyeOpen">M1.5,8 C4.5,4 11.5,4 14.5,8 C11.5,12 4.5,12 1.5,8 Z M6,8 A2,2 0 1 1 10,8 A2,2 0 1 1 6,8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEyeClosed">M1.5,7 C4.5,11 11.5,11 14.5,7 M4,9.9 L3.2,11.5 M8,10.6 L8,12.2 M12,9.9 L12.8,11.5</StreamGeometry>

        <!-- Viewport tool-shelf icons (16×16). Select is filled; Move/Rotate/Scale are stroked. -->
        <StreamGeometry x:Key="IconToolSelect">M3,2 L3,12.5 L6,9.7 L7.9,13.8 L9.7,13 L7.8,9 L11.5,9 Z</StreamGeometry>
        <StreamGeometry x:Key="IconToolMove">M8,1.5 L8,14.5 M1.5,8 L14.5,8 M5.5,4 L8,1.5 L10.5,4 M5.5,12 L8,14.5 L10.5,12 M4,5.5 L1.5,8 L4,10.5 M12,5.5 L14.5,8 L12,10.5</StreamGeometry>
        <StreamGeometry x:Key="IconToolRotate">M8,3 A5,5 0 1 1 3.67,5.5 M6.8,1.6 L8.4,3 L6.8,4.4</StreamGeometry>
        <StreamGeometry x:Key="IconToolScale">M4,12 L12,4 M4,12 L4,8.5 M4,12 L7.5,12 M12,4 L12,7.5 M12,4 L8.5,4</StreamGeometry>

        <!-- Walk mode: a figure mid-stride — solid head, heavy limbs with round caps. Drawn thick on
             purpose: at 22px a hairline stick figure reads as a scribble. -->
        <StreamGeometry x:Key="IconToolWalk">M9.2,1.6 A1.9,1.9 0 1 1 9.19,1.6 M9.1,5.6 L7.7,9.2 L5.2,12.2 M7.7,9.2 L10.6,11 L11.2,14.4 M5.2,12.2 L4.6,14.4 M8.6,6.6 L11.9,7.8</StreamGeometry>

        <!-- The Blender mark, verbatim from the official logo SVG (body-with-eye-hole subpaths plus
             the eye ball appended as an absolute subpath) — even-odd fill turns it into the
             monochrome logo: solid body, empty ring, filled pupil. -->
        <StreamGeometry x:Key="IconBlender">m231-330c0.013 0.74 0.249 2.18 0.603 3.3 0.744 2.38 2.01 4.58 3.76 6.51 1.8 1.99 4.02 3.59 6.58 4.73 2.69 1.19 5.61 1.8 8.64 1.8 3.03-4e-3 5.95-0.624 8.64-1.83 2.56-1.15 4.78-2.75 6.58-4.75 1.76-1.95 3.02-4.15 3.76-6.53 0.375-1.2 0.612-2.42 0.707-3.64 0.093-1.2 0.054-2.41-0.117-3.62-0.334-2.35-1.15-4.56-2.4-6.56-1.14-1.85-2.62-3.46-4.38-4.82l4e-3 -3e-3 -17.7-13.6c-0.016-0.012-0.029-0.025-0.046-0.036-1.16-0.892-3.12-0.889-4.39 5e-3 -1.29 0.904-1.44 2.4-0.29 3.34l-5e-3 5e-3 7.39 6.01-22.5 0.024h-0.03c-1.86 2e-3 -3.65 1.22-4 2.77-0.364 1.57 0.9 2.88 2.84 2.88l-3e-3 7e-3 11.4-0.022-20.4 15.6c-0.026 0.019-0.054 0.039-0.078 0.058-1.92 1.47-2.54 3.92-1.33 5.46 1.23 1.57 3.84 1.58 5.78 9e-3l11.1-9.1s-0.162 1.23-0.149 1.96zm28.6 4.11c-2.29 2.33-5.5 3.66-8.96 3.66-3.47 6e-3 -6.68-1.3-8.97-3.63-1.12-1.14-1.94-2.44-2.45-3.83-0.497-1.37-0.69-2.82-0.562-4.28 0.121-1.43 0.547-2.8 1.23-4.03 0.668-1.21 1.59-2.31 2.72-3.24 2.23-1.81 5.06-2.8 8.02-2.8 2.97-4e-3 5.8 0.969 8.03 2.78 1.13 0.924 2.05 2.02 2.72 3.23 0.683 1.23 1.11 2.59 1.23 4.03 0.126 1.46-0.067 2.91-0.564 4.28-0.508 1.4-1.33 2.7-2.45 3.84z M243,-334c0.106-1.89 1.03-3.56 2.43-4.74 1.37-1.16 3.21-1.87 5.23-1.87 2.01 0 3.85 0.709 5.22 1.87 1.4 1.18 2.32 2.85 2.43 4.74 0.106 1.94-0.675 3.75-2.04 5.09-1.4 1.36-3.38 2.22-5.61 2.22s-4.22-0.854-5.61-2.22c-1.37-1.34-2.15-3.14-2.04-5.08z</StreamGeometry>

        <!-- Eye toggle: a proper square button (persistent gray fill, like ToolSquareButton), pinned to the
             row's right edge. Vector eye — open when visible, closed (dimmed) when the branch is hidden. -->
        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceChip}" CornerRadius="4">
                            <Path x:Name="Icon" Width="12" Height="12" Stretch="Uniform"
                                  Fill="Transparent" Stroke="{StaticResource GlyphOn}" StrokeThickness="1.2"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource IconEyeOpen}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Icon" Property="Data" Value="{StaticResource IconEyeClosed}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource GlyphOff}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceChipHot}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceChipDown}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree expand/collapse chevron: points right when collapsed, rotates down when expanded.
             Occupies a fixed width so leaf rows align under their parent's label. -->
        <Style x:Key="TreeChevron" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16">
                            <TextBlock x:Name="Chev" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Text="&#xE76C;" Foreground="{StaticResource TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chev" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chev" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scene stats strip: a large value over a small caption. -->
        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <!-- Center action bar: blue "Play" button (rectangular, glyph + label). -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Text="&#xE768;"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Play" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDown}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Center action bar: square gray icon buttons (multiplayer, build). Dims when disabled. -->
        <Style x:Key="ToolSquareButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlDown}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One half of a two-way switch between two READINGS of the same thing — the scene panel's
             Components | Raw. Same cell shape and accent as the numbered strip below it, but radio buttons:
             there are exactly two, they are named rather than numbered, and neither is a list of anything. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}" />
                            </MultiTrigger>
                            <!-- Greyed, and LAST so it wins over the accent above: the level-of-detail switch
                                 is disabled on the cars that carry a single level, and a segmented control
                                 that looks live and ignores every click reads as a bug rather than as an
                                 answer. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A numbered strip for picking one of a handful of same-shaped things — the tuning tab's tables.
             Same visual language as the render-mode selector below (rounded cell, accent when current), but
             a ListBox rather than radio buttons: the selection is bound, not counted, and arrow keys work.
             A ListBox for its behaviour only — every scrap of list chrome is templated away. -->
        <Style x:Key="NumberStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <!-- The trailing cell's own gap, taken back, so the strip ends flush with the card it sits in
                 instead of stopping one gap short of it. -->
            <Setter Property="Margin" Value="0,0,-4,0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <!-- One row of equal cells filling the width: a segmented control, not a handful of
                             small squares adrift in a wide card. Safe as one row — no entity-data storage in
                             the game holds more than six tables. -->
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberStripItem" TargetType="ListBoxItem">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Render-mode selector (Blender-style): square icon toggles, mutually exclusive via GroupName.
             Gray by default, accent-blue when active (the current shading mode). -->
        <Style x:Key="RenderModeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Viewport tool-shelf button (Blender-style): larger square icon toggle, mutually exclusive
             via GroupName. Gray by default, accent-blue when the tool is active. -->
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain shelf toggle: gray idle, accent-blue when on — the same on/off colours the tool
             radio buttons above it use, so "this mode is active" always looks the same. -->
        <Style x:Key="ToolToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHot}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Blender edit-mode toggle (bottom of the tool shelf): gray like the other tools when idle,
             Blender-orange while a bridge session is active — the one place the brand colour is the point,
             which is why it does not share the blue toggle above. IsChecked mirrors the REAL session
             state (set from code) — the click only requests the toggle. -->
        <Style x:Key="BlenderToolButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Blender}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BlenderHot}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Render tab: modern toggle switch + vertical icon-tab strip ═══ -->

        <!-- Pill toggle switch: a ToggleButton retemplated as a rounded track + sliding knob.
             OFF = neutral-gray track (SurfaceControl, hover SurfaceControlHot), knob parked left.
             ON  = accent-blue track (Accent, on-hover AccentHot), knob glides 18px right (120ms). -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="{TemplateBinding Background}"
                                CornerRadius="9" BorderBrush="{StaticResource EdgeSoft}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource SurfaceControlHot}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHot}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHot}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical tab strip: slim left icon column (panel tint + right hairline) beside a
             chromeless content host. Fully overrides the default Fluent tab chrome. -->
        <Style x:Key="VerticalTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Transparent strip: blends with the content + the tree above (no two-tone
                                 band); only the hairline divider and the selected cell define the icon rail. -->
                            <Border Grid.Column="0" Background="Transparent"
                                    BorderBrush="{StaticResource EdgeFaint}" BorderThickness="0,0,1,0">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True"
                                          Panel.ZIndex="1" Margin="0,4,0,0" />
                            </Border>
                            <Border Grid.Column="1" Background="Transparent">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat icon-only tab cell. Idle = transparent + muted (TextMuted). Selected = selection
             tint fill (SelectionFill) + a 2px accent bar on the inner right edge + white glyph.
             Hover = subtle FillHover row-hover tint. Glyph comes from Tag; Header stays for the
             tooltip/accessibility only (not shown). -->
        <Style x:Key="VerticalTab" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <!-- Foreground = the tab's meaning colour (set per TabItem); Blender-style coloured icon rail.
                 The glyph dims when idle, brightens on hover/select; the accent bar picks up the same colour. -->
            <Setter Property="Foreground" Value="{StaticResource GlyphIdle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Width="32" Height="32" SnapsToDevicePixels="True">
                            <Border x:Name="Cell" Background="Transparent" CornerRadius="4" Margin="2" />
                            <Border x:Name="AccentBar" Width="2" HorizontalAlignment="Right" Opacity="0"
                                    Background="{TemplateBinding Foreground}" SnapsToDevicePixels="True" />
                            <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Opacity="0.62"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- ...or a drawn icon, when the tab stands for something the CONTENT BROWSER
                                 already draws. A tab and a tile meaning the same resource must not be two
                                 different pictures, so those tabs put the browser's own geometry in Icon
                                 and this Path shows instead of the glyph above. -->
                            <Path x:Name="Vector" Width="16" Height="16" Stretch="Uniform" Opacity="0.62"
                                  Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{Binding (v:TabIcon.Icon), RelativeSource={RelativeSource TemplatedParent}}"
                                  Stroke="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding (v:TabIcon.Icon), RelativeSource={RelativeSource Self}}"
                                         Value="{x:Null}">
                                <Setter TargetName="Vector" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding (v:TabIcon.HasIcon), RelativeSource={RelativeSource Self}}"
                                         Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{StaticResource FillHover}" />
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{StaticResource FillActive}" />

                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                <Setter TargetName="AccentBar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Property tabs: shared converters + card/typography styles (dark, Blender-ish) ═══ -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Grouping card: rounded panel-tint block with a hairline border (matches the scene-stats strip). -->
        <Style x:Key="PropCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FillCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeFaint}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- A card that is itself a button: the header of a foldable group. The highlight lives HERE and not
             on the toggle inside it, so the whole block lights up as one — a toggle that paints its own hover
             lights only the part of the row it happens to occupy, and the add button beside it becomes a hole
             in the middle of the highlight. -->
        <Style x:Key="GroupHeaderCard" TargetType="Border" BasedOn="{StaticResource PropCard}">
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource FillHover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource EdgeNeutral}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Selection header: object name (bold) over a dim type caption. -->
        <Style x:Key="PropTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="PropSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Section caption over a group of rows: the app's one Caption, in sentence case like every other
             label, with the wider gap a card of rows needs under its name. -->
        <Style x:Key="PropCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Read-only metadata: "Label   value" row (label dim-left, value white-right). -->
        <Style x:Key="MetaLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- One "label … value" metadata row (used across SDS / FrameResource / Scene tabs). -->
        <Style x:Key="MetaRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Plain single-line input styled to match the Vector3Box cells (dark, rounded, accent on focus).
             Used for the camera-speed field so it reads as the same kind of control, just without the axis
             prefix / copy button. -->
        <Style x:Key="InputField" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="{Binding Path=(v:Density.ControlHeight), RelativeSource={RelativeSource Self}}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ───── Browsers under a viewport (ContentBrowser, PropsBrowser) ───── -->
        <!-- The two panes are the same kind of thing — tiles to put on the stage, folded away by a tab — so
             they are drawn from one set of parts. -->
        <StreamGeometry x:Key="BrowserFind">M2.1,5.2 A3.1,3.1 0 1 1 8.3,5.2 A3.1,3.1 0 1 1 2.1,5.2 Z M7.5,7.5 L10.4,10.4</StreamGeometry>

        <!-- A browser's action button: the box of the content browser's Up button, widened for a label, for
             the one control in a browser's row that does something rather than navigating — Import in the
             content browser, Rescan in the props browser. -->
        <Style x:Key="BrowserAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1"
                                Padding="8,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The fold of a browser under a viewport: a tab standing on the browser's top edge and sticking UP out of it, rounded on the
             top corners only and open at the bottom, so it reads as one piece with the pane it opens. The
             negative margin is what puts it outside; nothing between here and the window clips, so it draws
             and takes clicks over the divider and the bottom of the stage.
             Chevron down while the body is open (the way it will travel), up once it is folded away. -->
        <Style x:Key="BrowserHandle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-16,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource EdgeRaised}"
                                BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Chev" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       Text="&#xE70E;" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chev" Property="Text" Value="&#xE70D;" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceRaisedHot}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeHot}" />
                                <Setter TargetName="Chev" Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A panel's search field (scene tree, browsers), matching the property panel's inputs. The left inset
             clears the magnifier (BrowserFind), which the host lays over the field, and puts typed text on the
             placeholder's 28 px line: border 1 + inset 25 + the text view's own 2. -->
        <Style x:Key="BrowserSearch" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{StaticResource SelectionText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="25,0,8,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A browser's tile — an archive in the content browser, a stock object in the props browser: a
             square of empty space with a picture or a big type icon in it, the name, and one line under it. An
             .sds is not opened to build this pane, so the icon is what a tile starts with; the archives that
             hold one figure — people, clothes — then get its picture, drawn in the background and kept on
             disk (see ArchiveThumb).
             No card: a hundred filled, outlined boxes read as a wall rather than as a hundred things, so the
             tile is nothing until the pointer or the selection is on it. What separates one from the next is
             the gap, not a border.
             100px with a 12px gap is measured, not taste: two rows of tile+gap have to clear the browser's
             opening height at 720p, where the host caps it at half the stage (see FoldingPaneRow),
             once the panel's own 8px inset is off it. A row and a bit reads as a pane that failed to finish
             drawing. -->
        <Style x:Key="BrowserTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Width="100" Height="100" CornerRadius="8"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionFill}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Menus: the window menu bar and every context menu =================
             Fluent's menu is sized for touch (14 px text, 40 px rows) and will not shrink by padding — it clips
             the text — so the windows used to scale the whole bar to 0.8, which blurs every glyph that lands
             between pixels. These templates draw it at its real size instead: 12 px text on 28 px rows, the
             popup in the same card as the toolbar flyouts, hotkeys in a column of their own. Implicit, so the
             context menus built in code get the same look without asking for it. -->

        <!-- The card every menu popup is drawn in. Its margin is room for the shadow: the popup window has to
             be that much bigger than the card, so each popup offsets itself back by the same 8 px. -->
        <Style x:Key="MenuPopupCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PopupSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource EdgeNeutral}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="8,0,8,8" />
            <Setter Property="MinWidth" Value="200" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Menu">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Style="{StaticResource MenuPopupCard}" Margin="0,0,8,8">
                            <ItemsPresenter Grid.IsSharedSizeScope="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            KeyboardNavigation.TabNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="8,4" Background="{StaticResource EdgeSoft}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A word on the bar. Its list drops straight down, left edges flush. -->
        <ControlTemplate x:Key="MenuTopLevelTemplate" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="Bd" Margin="0,2" Padding="8,0" MinHeight="24" CornerRadius="4" Background="Transparent">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                </Border>
                <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-8" VerticalOffset="2"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <Border Style="{StaticResource MenuPopupCard}">
                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHot}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHot}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- A row inside a list: name, then its hotkey in a column shared by the whole list, then the arrow of
             a nested list. A nested list opens to the right with its first row level with this one. -->
        <ControlTemplate x:Key="MenuSubmenuTemplate" TargetType="MenuItem">
            <Grid SnapsToDevicePixels="True">
                <Border x:Name="Bd" MinHeight="28" Padding="12,0,8,0" CornerRadius="4" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                            <ColumnDefinition Width="16" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                          VerticalAlignment="Center" />
                        <TextBlock x:Name="Gesture" Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"
                                   Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource TextMuted}" />
                        <Path x:Name="Arrow" Grid.Column="2" Width="4" Height="8" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed"
                              Data="M0,0 L4,4 L0,8" StrokeThickness="1.2" StrokeLineJoin="Round"
                              Stroke="{StaticResource TextSecondary}" />
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-3" VerticalOffset="-5"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                    <Border Style="{StaticResource MenuPopupCard}">
                        <ItemsPresenter Grid.IsSharedSizeScope="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Cycle" />
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHot}" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextPrimary}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template" Value="{StaticResource MenuSubmenuTemplate}" />
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource MenuTopLevelTemplate}" />
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource MenuTopLevelTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

</ResourceDictionary>
