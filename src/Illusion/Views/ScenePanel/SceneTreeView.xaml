<UserControl x:Class="Illusion.Views.SceneTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Illusion.Scene"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- What the loaded content is made of: one row per node, with the eye toggle that hides it and the
         menu that acts on it. The placard below shares the cell with the tree and takes its place when
         there is nothing to list. -->

    <Grid>
        <!-- Nothing open: the hierarchy says so rather than showing an empty box, which reads as a panel that
             failed instead of a window waiting for a resource. Shares the stage page's shape and wording. -->
        <StackPanel x:Name="EmptyScene" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Path Width="46" Height="46" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource StageGlyph}"
                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Data="{StaticResource IconScene}" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyTitle" Text="No hierarchy yet" Foreground="{StaticResource TextSecondary}" FontSize="13"
                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="EmptyHint" Text="Open a resource to see what is in it" Foreground="{StaticResource TextMuted}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />
        </StackPanel>

        <TreeView x:Name="SceneTree" Margin="8,0,8,0" BorderThickness="0"
                  Background="Transparent"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ContextMenu>
                <ContextMenu Opened="SceneTreeContextMenu_Opened">
                    <MenuItem x:Name="TreeDuplicateItem" Header="Duplicate"
                              Click="DuplicateMenuItem_Click" />
                    <MenuItem x:Name="TreeDeleteItem" Header="Delete" Click="DeleteMenuItem_Click" />
                    <Separator />
                    <!-- A car's collision is added on the COMPONENT tree, by role and shape, in the
                         component's own space — not here. This menu used to offer it off a raw bone and
                         wrote the prefab on its own, which is the second write path ticket 13 closed. -->
                    <MenuItem x:Name="TreeRemoveUnusedHullsItem" Header="Remove unused hulls"
                              Click="RemoveUnusedHulls_Click" />
                    <Separator />
                    <!-- Header carries the clicked row's archive name (set when the menu opens), so the
                         rollback target is readable before committing to the dialog. -->
                    <MenuItem x:Name="TreeRestoreBackupItem" Header="Restore Backup…"
                              Click="TreeRestoreBackup_Click" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <!-- Custom template: header stretches to the panel's right edge (its column is *),
                     so the eye toggle is always pinned to the right. Own chevron + row hover/selection. -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <!-- IsSelected is NOT bound to the node: multi-select needs several rows highlighted at
                         once, which the TreeView's single-selection would fight. The row highlight below
                         binds the node's own IsSelected flag (driven by the viewport), and Ctrl+click is
                         handled in code (SceneTree_PreviewMouseLeftButtonDown). -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="Row" Grid.Row="0" CornerRadius="4"
                                            Padding="2,0" MinHeight="24">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource FillHover}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                                        <Setter Property="Background" Value="{StaticResource SelectionFill}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="Expander" Grid.Column="0"
                                                          Style="{StaticResource TreeChevron}"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="12,0,0,0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="False">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <!-- Recursive node: type icon · name (bold for containers) · eye toggle (pinned right) -->
                <HierarchicalDataTemplate DataType="{x:Type r:SceneNode}"
                                          ItemsSource="{Binding ChildrenView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Resource-type icon (color + shape by Kind) -->
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Slate}" />
                                    <Setter Property="Data" Value="{StaticResource IconEmpty}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Amber}" />
                                            <Setter Property="Data" Value="{StaticResource IconFolder}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Sds">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Lilac}" />
                                            <Setter Property="Data" Value="{StaticResource IconArchive}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="FrameResource">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Violet}" />
                                            <Setter Property="Data" Value="{StaticResource IconMesh}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Scene">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Cyan}" />
                                            <Setter Property="Data" Value="{StaticResource IconScene}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Mesh">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Mint}" />
                                            <Setter Property="Data" Value="{StaticResource IconMesh}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Model">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Mint}" />
                                            <Setter Property="Data" Value="{StaticResource IconMesh}" />
                                        </DataTrigger>
                                        <!-- A level of detail of the mesh above it: the same stack-of-sheets
                                             the toolbar uses for layers, dimmed — it is one reading of an
                                             object, not an object of its own. -->
                                        <DataTrigger Binding="{Binding Kind}" Value="Lod">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Slate}" />
                                            <Setter Property="Data" Value="{StaticResource IconLayers}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Light">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Gold}" />
                                            <Setter Property="Data" Value="{StaticResource IconLight}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Camera">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Denim}" />
                                            <Setter Property="Data" Value="{StaticResource IconCamera}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Collision">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Coral}" />
                                            <Setter Property="Data" Value="{StaticResource IconCollision}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Navigation">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Emerald}" />
                                            <Setter Property="Data" Value="{StaticResource IconScene}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="NavLayer">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Emerald}" />
                                            <Setter Property="Data" Value="{StaticResource IconEmpty}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Actors">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Orange}" />
                                            <Setter Property="Data" Value="M6,0.6 L11.4,6 L6,11.4 L0.6,6 Z" />
                                        </DataTrigger>
                                        <!-- The rig of a skinned model, and one of its bones. A bone is drawn
                                             the way a skeleton overlay draws it: a joint with a shaft. -->
                                        <DataTrigger Binding="{Binding Kind}" Value="Skeleton">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Magenta}" />
                                            <Setter Property="Data"
                                                    Value="M6,1.4 A1.5,1.5 0 1 1 6,4.4 A1.5,1.5 0 1 1 6,1.4 Z M6,4.4 L3.4,10.4 M6,4.4 L8.6,10.4" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Bone">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Magenta}" />
                                            <Setter Property="Data"
                                                    Value="M3.2,8.8 A1.6,1.6 0 1 1 3.2,8.79 M8.8,3.2 A1.6,1.6 0 1 1 8.8,3.19 M4.4,7.6 L7.6,4.4" />
                                        </DataTrigger>
                                        <!-- A frame hanging off a bone: the same joint dot, on a leader. -->
                                        <DataTrigger Binding="{Binding Kind}" Value="Attachment">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Teal}" />
                                            <Setter Property="Data"
                                                    Value="M2,6 L6.4,6 M8,6 A1.6,1.6 0 1 1 8,5.99 M6.4,4.2 L6.4,7.8" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Actor">
                                            <Setter Property="Stroke" Value="{x:Static v:PaletteInk.Orange}" />
                                            <Setter Property="Data" Value="M6,2.2 L9.8,6 L6,9.8 L2.2,6 Z" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContainer}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ToggleButton Grid.Column="2" Style="{StaticResource EyeToggle}"
                                      Margin="8,2,6,2"
                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                      ToolTip="Show / hide" />
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
