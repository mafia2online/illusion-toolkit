<UserControl x:Class="Illusion.Views.PropsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Props tab: the stock game's doors, furniture, plants and lamps, from every extracted interior, as
         tiles with a picture. Drag a tile onto the viewport to put the object where it lands, or double-click
         it to put it in front of the camera; it arrives in the loaded district with everything it needs. -->

    <Grid Margin="10,10,10,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PropCard}">
            <StackPanel>
                <TextBlock Text="Props" Style="{StaticResource PropTitle}" />
                <TextBlock x:Name="Status" Style="{StaticResource PropSubtitle}" TextWrapping="Wrap"
                           Text="Stock objects from the game's interiors" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox" Padding="26,5,6,5" TextChanged="Filter_Changed" />
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12"
                           Foreground="{StaticResource TextFaint}" Margin="8,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="Filter_Changed"
                      ToolTip="Shelf" />
            <Button Grid.Column="2" Margin="6,0,0,0" Padding="8,4" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;"
                    ToolTip="Scan the archives again (after extracting more of them)" Click="Rescan_Click" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Collision" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                       VerticalAlignment="Center" Margin="2,0,8,0" />
            <ComboBox x:Name="CollisionBox" Grid.Column="1" SelectedIndex="0"
                      ToolTip="What collision a piece of scenery brings. Doors and physics props always bring their own.">
                <ComboBoxItem Content="Auto — its own, else convex hull" Tag="Auto" />
                <ComboBoxItem Content="Convex hull" Tag="Convex" />
                <ComboBoxItem Content="Box" Tag="Box" />
                <ComboBoxItem Content="Every triangle (heavy)" Tag="Mesh" />
                <ComboBoxItem Content="None" Tag="None" />
            </ComboBox>
        </Grid>

        <ListBox x:Name="Tiles" Grid.Row="3" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="False"
                 ScrollViewer.ScrollChanged="Tiles_ScrollChanged"
                 MouseDoubleClick="Tiles_MouseDoubleClick"
                 PreviewMouseLeftButtonDown="Tiles_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="Tiles_PreviewMouseMove">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="1" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="136" CornerRadius="5" Background="{StaticResource FillCard}"
                            BorderBrush="{StaticResource EdgeFaint}" BorderThickness="1" ToolTip="{Binding ToolTip}">
                        <StackPanel>
                            <Grid Height="96" Margin="3,3,3,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="26"
                                           Foreground="{StaticResource TextFaint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" Margin="6,3,6,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource TextMuted}"
                                       Margin="6,0,6,5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
