<UserControl x:Class="Illusion.Views.TypeTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- Per-type property tab: the selected object type's own fields (Mesh / Light / Camera / …). One
         contextual tab whose header + content switch with the selection's type. -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,8,8,4">
            <Border Style="{StaticResource PropCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PropTitle}" />
                    <TextBlock Text="{Binding ObjectType}" Style="{StaticResource PropSubtitle}" />
                </StackPanel>
            </Border>
            <v:PropertyList Groups="{Binding TypeGroups}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
