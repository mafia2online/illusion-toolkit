<UserControl x:Class="Illusion.Views.ComponentTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Illusion.ViewModels"
             xmlns:v="clr-namespace:Illusion.Views">

    <!-- What the CAR is made of: one row per component — a door, a bumper, a licence plate — named after its
         own bone and nested by the prefab's own parent link, with the bare ones (no deform part claims them)
         standing alongside. The frame tree it takes the place of is one switch away, in the panel above. -->

    <UserControl.Resources>
        <v:ComponentGlyphConverter x:Key="ComponentGlyph" />
        <v:ComponentTintConverter x:Key="ComponentTint" />
        <v:MarkerGlyphConverter x:Key="MarkerGlyph" />
        <v:MarkerTintConverter x:Key="MarkerTint" />
        <v:DamageGlyphConverter x:Key="DamageGlyph" />
        <v:HandleGlyphConverter x:Key="HandleGlyph" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- The honest empty state: a search that matched nothing is a tree with no rows rather than an
             empty box, which reads as a panel that failed. Shares the frame tree's placard shape. The line
             underneath is set in code, because there are two ways to have no rows and they are not the same
             answer — nothing matched what was typed, or nothing of this car is drawn at the level chosen. -->
        <StackPanel x:Name="EmptyComponents" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <Path Width="46" Height="46" Stretch="Uniform" Fill="Transparent" Stroke="{StaticResource StageGlyph}"
                  StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Data="{StaticResource IconMesh}" HorizontalAlignment="Center" />
            <TextBlock Text="No components" Foreground="{StaticResource TextSecondary}"
                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="EmptyHint" Text="Nothing in this car matched the search"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" />
        </StackPanel>

        <TreeView x:Name="ComponentTree" Margin="8,0,8,0" BorderThickness="0"
                  Background="Transparent"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling">
            <TreeView.ContextMenu>
                <!-- What a component can be given, and what one of its collisions can be done to. Everything
                     else that acts on a row — sweeping unused hulls, rolling the archive back — is still on
                     the frame tree's own menu, and a car opening on its components would otherwise hide the
                     only path to those behind a switch nobody has been told about. The selected component's
                     frame is what the frame tree lands on, so the way back is one click. -->
                <!-- Three of these items are DISABLED precisely when they have a reason to give — a cooked hull
                     that cannot be resized, a marker that carries nothing to type, a component that does not
                     crumple — and WPF drops a tooltip on a disabled element unless it is told not to, so each
                     of those three asks for ShowOnDisabled. Set on the ITEMS and not on this menu: the property
                     inherits in principle and measurably does not reach a ContextMenu's items — the component
                     tree probe reads it back as False there — so the reason was written and never readable. -->
                <ContextMenu Opened="Menu_Opened">
                    <!-- One more component of the car. A component IS a bone, so this is offered whichever
                         bone is named — and refused, in the window itself, when the bone would have to be
                         minted, which is every bone Blender has not made yet. The refusal is the aggregate's
                         single condition; when the rig writer lands it stops firing and this item does not
                         move. -->
                    <MenuItem x:Name="AddComponentItem" Header="Add component…"
                              ToolTipService.ShowOnDisabled="True" Click="AddComponent_Click" />
                    <!-- The two halves of a component's own deform part. A BARE component is offered one —
                         a light, a plate or a wiper made damageable — and one that has a part is offered
                         the way back out, because a grant a modder cannot take back is a one-way door.
                         Exactly one of the two is ever shown. -->
                    <MenuItem x:Name="GrantPartItem" Header="Make damageable…" Click="GrantPart_Click" />
                    <MenuItem x:Name="RemovePartItem" Header="Remove deform part"
                              ToolTipService.ShowOnDisabled="True" Click="RemovePart_Click" />
                    <!-- …and taking the component away altogether, which means taking its BONE away. Offered
                         beside the demotion because that is where a modder looks for it, and refused with
                         what it would renumber — plus the demotion, which is what they usually want. -->
                    <MenuItem x:Name="RemoveComponentItem" Header="Remove component"
                              ToolTipService.ShowOnDisabled="True" Click="RemoveComponent_Click" />
                    <MenuItem x:Name="AddCollisionItem" Header="Add collision…" Click="AddCollision_Click" />
                    <!-- The roles are filled in from the aggregate rather than spelled here: the two it
                         cannot mint are absent rather than greyed, because a wiper is a bone on all 148
                         shipped ones and a light is a slot rather than a row. -->
                    <MenuItem x:Name="AddMarkerItem" Header="Add marker" />
                    <MenuItem x:Name="EditCollisionItem" Header="Size and position…"
                              ToolTipService.ShowOnDisabled="True" Click="EditCollision_Click" />
                    <MenuItem x:Name="RemoveCollisionItem" Header="Remove collision"
                              Click="RemoveCollision_Click" />
                    <MenuItem x:Name="EditMarkerItem" Header="Marker data…"
                              ToolTipService.ShowOnDisabled="True" Click="EditMarker_Click" />
                    <MenuItem x:Name="RemoveMarkerItem" Header="Remove marker" Click="RemoveMarker_Click" />
                    <MenuItem x:Name="EditDataRowItem" Header="Row…" Click="EditDataRow_Click" />
                    <!-- What this component does when it is hit, and how far it caves in. Both act on the row
                         beneath the component rather than on the component itself, because both are the
                         component's own deform part and a bare one has neither. -->
                    <MenuItem x:Name="EditDamageItem" Header="Damage…" Click="EditDamage_Click" />
                    <MenuItem x:Name="EditHandleItem" Header="Crumple…"
                              ToolTipService.ShowOnDisabled="True" Click="EditHandle_Click" />
                    <Separator />
                    <MenuItem Header="Show in Raw tree" Click="ShowInRaw_Click" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <!-- The frame tree's own row shape, minus the eye: a component is a weight group inside one
                     skinned mesh, so there is no per-component geometry to show or hide. -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Right padding: the tree's scroll bar lies OVER the rows (Fluent), and a
                                         right-aligned summary without room for it reads "body," cut in half. -->
                                    <Border x:Name="Row" Grid.Row="0" CornerRadius="4"
                                            Padding="2,0,8,0" MinHeight="24">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource FillHover}" />
                                                    </Trigger>
                                                    <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                                        <Setter Property="Background" Value="{StaticResource SelectionFill}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton x:Name="Expander" Grid.Column="0"
                                                          Style="{StaticResource TreeChevron}"
                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="12,0,0,0" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="False">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <!-- Recursive row: kind icon · bone name · the kind in words.
                     The kind is SHOWN rather than inferred from the name: a cover names doorBL on seven
                     shipped cars, so the name is not the kind and reading it as one misleads on exactly the
                     cars this view exists for. -->
                <HierarchicalDataTemplate DataType="{x:Type vm:ComponentRowViewModel}"
                                          ItemsSource="{Binding ChildrenView}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{Binding Kind, Converter={StaticResource ComponentGlyph}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Stroke"
                                            Value="{Binding Kind, Converter={StaticResource ComponentTint}}" />
                                    <Style.Triggers>
                                        <!-- A bone that no longer resolves: the signature of a rename made in
                                             Blender. Shown broken rather than hidden — a disappearance is the
                                             one thing a modder cannot diagnose. -->
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource StatusError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                        <!-- What did not stitch about THIS component, on its own row. The car's full list is
                             above the tree; this is what makes a fault something a modder trips over rather
                             than something they have to go and read. The tooltip carries every one of them. -->
                        <Path Grid.Column="3" Width="12" Height="12" Stretch="Uniform" Fill="Transparent"
                              StrokeThickness="1.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              VerticalAlignment="Center" Margin="0,0,4,0" SnapsToDevicePixels="True"
                              Data="{StaticResource IconWarning}" ToolTip="{Binding FaultTip}"
                              Visibility="{Binding HasFault, Converter={StaticResource BoolToVis}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <!-- Faint for a component the game simply ships this way — 24 door parts
                                         over the corpus have no door row — and a warning only for a failure
                                         no shipped car raises. -->
                                    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBreak}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource StatusWarn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </HierarchicalDataTemplate>

                <!-- What this component does when it is HIT: its own mass, resistance, speed window, energy
                     and centre of mass, its effect group and its flags. The row says the part KIND beside it,
                     which is the one thing the component's name cannot tell the modder — a cover names doorBL
                     on seven shipped cars, and bumpers name bones called rezerva and krytmotoru. -->
                <DataTemplate DataType="{x:Type vm:ComponentDamageRowViewModel}">
                    <Grid ToolTip="{Binding Tip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Kind, Converter={StaticResource ComponentTint}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{Binding Kind, Converter={StaticResource DamageGlyph}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,4,0" />
                    </Grid>
                </DataTemplate>

                <!-- One bone this component crumples AROUND, with how far it travels — or the plain statement
                     that it crumples around none, which is how 1093 of the 1698 shipped parts are written and
                     is therefore worth saying rather than showing as an empty list.
                     A handle is NOT a component: deform_doorFL beside doorFL reads as two doors. -->
                <DataTemplate DataType="{x:Type vm:ComponentHandleRowViewModel}">
                    <Grid ToolTip="{Binding Tip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{StaticResource TextMuted}"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{Binding Label, Converter={StaticResource HandleGlyph}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <!-- The statement that there are none is the same mark, drawn faint:
                                             one question, two answers, rather than two unrelated rows. -->
                                        <DataTrigger Binding="{Binding HasFields}" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFields}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,4,0" />
                    </Grid>
                </DataTemplate>

                <!-- A collision of that component: what it is, what form it takes, and how big.
                     By ROLE and SHAPE — never the stored type, never whose bone space the matrix is in, and
                     never that one kind of volume states a full size while the other states half of one. -->
                <DataTemplate DataType="{x:Type vm:CollisionRowViewModel}">
                    <Grid ToolTip="{Binding ReadOnlyReason}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{StaticResource TextMuted}"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{StaticResource IconCollision}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Size}" Foreground="{StaticResource TextMuted}"
                                   FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                    </Grid>
                </DataTemplate>

                <!-- One of the prefab rows that names this component's OWN bone: a door's handle and lock, a
                     window's depth, an axle's masses. Not a marker — a marker hangs a helper frame off the
                     bone, this names the bone itself — but it sits here for the same reason: the modder
                     should not have to know which of the four parallel lists a number lives in. -->
                <DataTemplate DataType="{x:Type vm:ComponentDataRowViewModel}">
                    <Grid ToolTip="{Binding Tip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Row.Kind, Converter={StaticResource ComponentTint}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{Binding Row.Kind, Converter={StaticResource ComponentGlyph}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,4,0" />
                    </Grid>
                </DataTemplate>

                <!-- The markers of one ROLE, and the markers in it. Grouped rather than listed flat because
                     of where they land: the body holds every marker whose bone no component owns, 524 of the
                     1081 shipped ones, and a body with nineteen rows under it in no order is the flat pile
                     this view exists to take away, merely moved one level down. -->
                <HierarchicalDataTemplate DataType="{x:Type vm:MarkerGroupRowViewModel}"
                                          ItemsSource="{Binding Markers}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="12" Height="12" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Role, Converter={StaticResource MarkerTint}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{Binding Role, Converter={StaticResource MarkerGlyph}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </HierarchicalDataTemplate>

                <!-- One marker: what it is, and the frame it names. Clicking it selects that frame in the
                     viewport, so the next thing the modder does can be to drag it — which is the whole
                     operation for the four roles that carry no numbers of their own. -->
                <DataTemplate DataType="{x:Type vm:MarkerRowViewModel}">
                    <Grid ToolTip="{Binding Tip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="10" Height="10" Stretch="Uniform"
                              Fill="Transparent" StrokeThickness="1.15" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Marker.Role, Converter={StaticResource MarkerTint}}"
                              Opacity="0.75"
                              VerticalAlignment="Center" Margin="0,0,8,0" SnapsToDevicePixels="True"
                              Data="{Binding Marker.Role, Converter={StaticResource MarkerGlyph}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Name}"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,4,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="120" />
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</UserControl>
