<UserControl x:Class="Illusion.Views.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A shader parameter that is a COLOUR, shown as one: a swatch that opens a picker, beside the numbers
         it stands for. The numbers stay editable — they are the truth, and some of them are outside anything
         a picker can express — but nobody should have to guess what "0.27, 0.02, 0.02" looks like. -->

    <UserControl.Resources>
        <Style x:Key="SwatchButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="4" BorderBrush="{StaticResource EdgeHot}" BorderThickness="1"
                                Background="{Binding Swatch, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="LabelText" Grid.Column="0" Width="118" VerticalAlignment="Center"
                   Foreground="{StaticResource GlyphIdle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

        <ToggleButton x:Name="SwatchBtn" Grid.Column="1" Style="{StaticResource SwatchButton}"
                      Margin="0,0,8,0" ToolTip="Pick a colour" />

        <TextBox x:Name="ValueBox" Grid.Column="2" Style="{StaticResource DarkBox}"
                 VerticalContentAlignment="Center"
                 KeyDown="Value_KeyDown" LostFocus="Value_LostFocus" />

        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=SwatchBtn}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=SwatchBtn, Mode=TwoWay}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource PopupSurface}" BorderBrush="{StaticResource EdgeNeutral}"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,8,8">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <StackPanel Width="212">
                    <!-- Saturation across, value down, over the chosen hue. -->
                    <Grid Height="140" Margin="0,0,0,8">
                        <Border x:Name="SvArea" CornerRadius="4" ClipToBounds="True"
                                MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove"
                                MouseLeftButtonUp="Picker_MouseUp" Cursor="Cross">
                            <Grid>
                                <Border x:Name="HueFill" />
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#00000000" />
                                            <GradientStop Offset="1" Color="#FF000000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <Ellipse x:Name="SvThumb" Width="11" Height="11" Stroke="White" StrokeThickness="1.6"
                                 Fill="Transparent" IsHitTestVisible="False"
                                 HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="{StaticResource ShadowColor}" BlurRadius="3" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>

                    <!-- Hue. -->
                    <Grid Height="16" Margin="0,0,0,8">
                        <Border x:Name="HueArea" CornerRadius="4" ClipToBounds="True"
                                MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove"
                                MouseLeftButtonUp="Picker_MouseUp" Cursor="Cross">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0.000" Color="#FF0000" />
                                    <GradientStop Offset="0.167" Color="#FFFF00" />
                                    <GradientStop Offset="0.333" Color="#00FF00" />
                                    <GradientStop Offset="0.500" Color="#00FFFF" />
                                    <GradientStop Offset="0.667" Color="#0000FF" />
                                    <GradientStop Offset="0.833" Color="#FF00FF" />
                                    <GradientStop Offset="1.000" Color="#FF0000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="HueThumb" Width="4" Height="20" CornerRadius="2" Background="White"
                                BorderBrush="#80000000" BorderThickness="1" IsHitTestVisible="False"
                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hex" Foreground="{StaticResource GlyphIdle}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="HexBox" Grid.Column="1" Style="{StaticResource DarkBox}"
                                 VerticalContentAlignment="Center" MaxLength="7"
                                 KeyDown="Hex_KeyDown" LostFocus="Hex_LostFocus" />
                    </Grid>

                    <TextBlock Text="Shown the way the viewport shows it; the numbers stay linear"
                               Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
