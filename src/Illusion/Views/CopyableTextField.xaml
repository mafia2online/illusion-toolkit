<UserControl x:Class="Illusion.Views.CopyableTextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Illusion.Views">
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextMuted}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <!-- Flat icon buttons (copy always, paste only when editable), dim glyph brightening on hover. The
                 same 24 px squares as a vector box's, so the two kinds of row line up in one card. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style x:Key="IconBtn" TargetType="Button">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Width" Value="24" />
                        <Setter Property="Height" Value="24" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                        <TextBlock x:Name="Glyph" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{TemplateBinding Content}" Foreground="{StaticResource TextMuted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource EdgeFaint}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>
                <Button x:Name="PasteBtn" Style="{StaticResource IconBtn}" Content="&#xE77F;"
                        Click="Paste_Click" ToolTip="Paste" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Click="Copy_Click" ToolTip="Copy" />
                <Button x:Name="DeleteBtn" Style="{StaticResource IconBtn}" Content="&#xE74D;"
                        Click="Delete_Click" ToolTip="Remove" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="Field"
                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                 IsReadOnly="{Binding ReadOnly}"
                 KeyDown="Field_KeyDown"
                 Foreground="{StaticResource TextPrimary}" FontSize="12" FontFamily="Consolas" MinHeight="0"
                 Height="{Binding Path=(v:Density.ControlHeight), RelativeSource={RelativeSource Self}}"
                 CaretBrush="White" SelectionBrush="{StaticResource SelectionText}">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="Bd" CornerRadius="4" Background="{StaticResource SurfaceInput}"
                                        BorderBrush="{StaticResource EdgeInput}" BorderThickness="1" SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="8,0,8,0" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeStrong}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceInputHot}" />
                                    </Trigger>
                                    <Trigger Property="IsReadOnly" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceSunken}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TextBox.Style>
        </TextBox>
    </StackPanel>
</UserControl>
