<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The toolkit's one colour scheme. Every window, control template and code path that paints something
         takes its colour from here, so a shade exists once and cannot drift between two files.

         Three rules the scheme is built on:

         1. THE CHROME IS NEUTRAL GREY. Every surface below has R = G = B. The scheme used to carry a family of
            near-neutrals with the blue channel 3-6 steps above the red (#1C1C20, #1B1B1E, #212227, #17181B,
            #101216, ...), which read as dark blue next to the two surfaces that were already neutral — the
            toolbar band (#2D2D2D) and the Fluent window itself (#202020). Colour belongs to the accent, the
            status dots and the category ink; the chrome carries none.
         2. COLOUR IS NAMED BY WHAT IT PAINTS, not by its value. A key says "an input at rest" or "a row under
            the pointer"; two roles that happen to share a value keep two keys, so one can move without the
            other.
         3. NOTHING FOLLOWS WINDOWS. The last section pins the Fluent theme's accent — see the comment there.

         Colours that are NOT part of the scheme, and deliberately stay where they are: the hue wheel and the
         saturation/value plane in ColorField (they are the colour picker's subject, not its chrome), and the
         categorical ink table in Palette.cs (a lookup keyed by an enum — same reason the icon geometry beside
         it lives in code). -->

    <!-- ══════════════════════════════ Surfaces ══════════════════════════════
         The window's own plate is Fluent dark's #202020; everything here is placed against it. Ordered dark
         to light so the ramp can be read as a ramp. -->

    <Color x:Key="SurfaceWellColor">#111111</Color>
    <Color x:Key="SurfaceSunkenColor">#171717</Color>
    <Color x:Key="StageBottomColor">#181818</Color>
    <Color x:Key="SurfacePaneColor">#1B1B1B</Color>
    <Color x:Key="SurfaceInputColor">#1C1C1C</Color>
    <Color x:Key="SurfaceWindowColor">#202020</Color>
    <Color x:Key="StageTopColor">#232323</Color>
    <Color x:Key="SurfaceInputHotColor">#252525</Color>
    <Color x:Key="SurfaceChipDownColor">#292929</Color>
    <Color x:Key="SurfaceRaisedColor">#2A2A2A</Color>
    <Color x:Key="SurfaceBandColor">#2D2D2D</Color>
    <Color x:Key="SurfaceChipColor">#333333</Color>
    <Color x:Key="SurfaceRaisedHotColor">#3A3A3A</Color>
    <Color x:Key="SurfaceControlDownColor">#3D3D3D</Color>
    <Color x:Key="EdgeNeutralColor">#454545</Color>
    <Color x:Key="SurfaceControlColor">#4D4D4D</Color>
    <Color x:Key="SurfaceControlHotColor">#5E5E5E</Color>

    <!-- The deepest plate there is: the well a texture chip or a material sphere sits in, where the point is
         that the picture stops and the window has not started yet. -->
    <SolidColorBrush x:Key="SurfaceWell" Color="{StaticResource SurfaceWellColor}" />
    <!-- A recessed plate: a read-only field, the page a texture is shown on, a picker's list well. -->
    <SolidColorBrush x:Key="SurfaceSunken" Color="{StaticResource SurfaceSunkenColor}" />
    <!-- A docked pane's own plate — the content browser under the stage. -->
    <SolidColorBrush x:Key="SurfacePane" Color="{StaticResource SurfacePaneColor}" />
    <!-- An editable field, and every dark control shaped like one (drop button, key capture). -->
    <SolidColorBrush x:Key="SurfaceInput" Color="{StaticResource SurfaceInputColor}" />
    <!-- ...with the caret in it, or held down. -->
    <SolidColorBrush x:Key="SurfaceInputHot" Color="{StaticResource SurfaceInputHotColor}" />
    <!-- Something standing ON the window rather than in it: the browser's fold tab. -->
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedHot" Color="{StaticResource SurfaceRaisedHotColor}" />
    <!-- The toolbar band, and the surface every drop-down in the app lands on. One step above the window it
         floats over, so a popup reads as nearer rather than as a hole. -->
    <SolidColorBrush x:Key="SurfaceBand" Color="{StaticResource SurfaceBandColor}" />
    <SolidColorBrush x:Key="PopupSurface" Color="{StaticResource SurfaceBandColor}" />
    <!-- A small square glyph button (the scene tree's eye). -->
    <SolidColorBrush x:Key="SurfaceChip" Color="{StaticResource SurfaceChipColor}" />
    <SolidColorBrush x:Key="SurfaceChipHot" Color="{StaticResource EdgeNeutralColor}" />
    <SolidColorBrush x:Key="SurfaceChipDown" Color="{StaticResource SurfaceChipDownColor}" />
    <!-- A full-size square icon button: the tool shelf, the render-mode strip, the toolbar's actions. -->
    <SolidColorBrush x:Key="SurfaceControl" Color="{StaticResource SurfaceControlColor}" />
    <SolidColorBrush x:Key="SurfaceControlHot" Color="{StaticResource SurfaceControlHotColor}" />
    <SolidColorBrush x:Key="SurfaceControlDown" Color="{StaticResource SurfaceControlDownColor}" />

    <!-- ══════════════════════════════ The stage ══════════════════════════════
         What the viewport column shows when there is no 3D in it: the "nothing staged" page and the texture
         page. Deliberately the same two shades as each other, so opening a texture reads as the stage
         changing rather than as a different window. -->

    <!-- The page itself, top to bottom. -->
    <LinearGradientBrush x:Key="StageBackdrop" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="{StaticResource StageTopColor}" Offset="0" />
        <GradientStop Color="{StaticResource StageBottomColor}" Offset="1" />
    </LinearGradientBrush>
    <!-- The flat form of the same page, for the texture view, and the lighter square of the board below. -->
    <SolidColorBrush x:Key="StageFlat" Color="{StaticResource StageBottomColor}" />
    <SolidColorBrush x:Key="StageTile" Color="{StaticResource StageTopColor}" />
    <!-- The big outline drawn on an empty stage. Bright enough to be a shape, dim enough not to be an object. -->
    <SolidColorBrush x:Key="StageGlyph" Color="{StaticResource SurfaceRaisedHotColor}" />
    <!-- The checkerboard behind a texture: a picture with an alpha hole and a picture that is simply dark look
         identical on a flat plate. Same two shades as the page it is drawn on. -->
    <DrawingBrush x:Key="StageChecker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="{StaticResource StageTile}">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <RectangleGeometry Rect="0,0,8,8" />
                        <RectangleGeometry Rect="8,8,8,8" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ══════════════════════════════ Fills ══════════════════════════════
         White at a low alpha, for things that lift off whatever plate they land on rather than naming a shade
         of their own — a row under the pointer has to work on the pane AND on the stage. -->

    <!-- A footer strip under a dialog's message, or any band that is barely there. -->
    <SolidColorBrush x:Key="FillHairline" Color="#0FFFFFFF" />
    <!-- A row, a tile or a tab cell under the pointer — and the plate of a grouping card, which is the same
         lift held permanently. -->
    <SolidColorBrush x:Key="FillHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FillCard" Color="#14FFFFFF" />
    <!-- A neutral (non-accent) button: at rest, under the pointer, held down. Pressed is DARKER than rest —
         the button sinks into the plate rather than lighting up. -->
    <SolidColorBrush x:Key="FillRest" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="FillHot" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="FillDown" Color="#10FFFFFF" />
    <!-- A neutral cell that is selected — used where the accent would be too loud for what is only "you are
         looking at this one" (the property tab rail). -->
    <SolidColorBrush x:Key="FillActive" Color="#22FFFFFF" />

    <!-- ══════════════════════════════ Edges ══════════════════════════════ -->

    <!-- The app's default rule: dividers, card outlines, rails, the top of a docked pane. -->
    <SolidColorBrush x:Key="EdgeFaint" Color="#1AFFFFFF" />
    <!-- A divider inside a strip, and the outline of a switch track. -->
    <SolidColorBrush x:Key="EdgeSoft" Color="#1FFFFFFF" />
    <!-- An input's own outline, at rest. -->
    <SolidColorBrush x:Key="EdgeInput" Color="#24FFFFFF" />
    <!-- Something raised off the plate: a framed picture, a tab standing on an edge. -->
    <SolidColorBrush x:Key="EdgeRaised" Color="#26FFFFFF" />
    <!-- A neutral button's outline. -->
    <SolidColorBrush x:Key="EdgeButton" Color="#2DFFFFFF" />
    <!-- An input or a shelf divider that has to be read rather than felt. -->
    <SolidColorBrush x:Key="EdgeStrong" Color="#38FFFFFF" />
    <!-- ...and the same under the pointer. -->
    <SolidColorBrush x:Key="EdgeHot" Color="#40FFFFFF" />
    <!-- A popup's edge. Neutral grey rather than white-alpha: on the dark chrome an alpha hairline reads as a
         lit outline instead of as a border. -->
    <SolidColorBrush x:Key="EdgeNeutral" Color="{StaticResource EdgeNeutralColor}" />
    <!-- A GridSplitter's groove — a shadow between two panes, not a line drawn on one. -->
    <SolidColorBrush x:Key="Splitter" Color="#22000000" />

    <!-- ══════════════════════════════ Scrims ══════════════════════════════
         Black at a high alpha, for the things that float OVER the viewport and must stay readable against
         whatever the scene happens to be. -->

    <SolidColorBrush x:Key="ScrimShelf" Color="#99000000" />
    <SolidColorBrush x:Key="ScrimPanel" Color="#B0000000" />
    <SolidColorBrush x:Key="ScrimTooltip" Color="#C4000000" />
    <!-- Every popup's drop shadow. -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- ══════════════════════════════ Text ══════════════════════════════
         Three roles and no more: what you read, what explains it, and what you only glance at. White at an
         alpha rather than a grey, so a label keeps its weight on every plate in the scheme. There used to be
         seven steps, and the bottom two fell under 4:1 on the window plate — a muted caption still has to be
         read. Hierarchy past these three comes from size and weight, not from another shade. -->

    <!-- Names, values, the text of a control: everything the eye lands on first. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <!-- A sentence that explains the line above it, a status message, a description. -->
    <SolidColorBrush x:Key="TextSecondary" Color="#B0FFFFFF" />
    <!-- Section captions, counts, units, placeholders, meta. About 5:1 on the window plate. -->
    <SolidColorBrush x:Key="TextMuted" Color="#80FFFFFF" />

    <!-- ══════════════════════════════ Glyph ink ══════════════════════════════
         Neutral greys for drawn icons — the render-mode spheres, the tool shelf, the eye toggle. Not text: an
         icon is a shape at 16px and needs a solid value, not an alpha that shifts with its plate. -->

    <SolidColorBrush x:Key="GlyphInk" Color="#ECECEC" />
    <!-- The shaded side of the render-mode sphere. -->
    <SolidColorBrush x:Key="GlyphInkDim" Color="#9A9A9A" />
    <!-- A toggled glyph: on, off, and the idle state of an icon rail. -->
    <SolidColorBrush x:Key="GlyphOn" Color="#CFCFCF" />
    <SolidColorBrush x:Key="GlyphOff" Color="#727272" />
    <SolidColorBrush x:Key="GlyphIdle" Color="#A0A0A0" />

    <!-- ══════════════════════════════ Accent ══════════════════════════════
         The one blue in the toolkit. It always carries white content, which is why the Fluent overrides at the
         bottom flip every on-accent glyph from black to white. -->

    <Color x:Key="AccentColor">#2D7DD2</Color>
    <Color x:Key="AccentHotColor">#3B8EE6</Color>
    <Color x:Key="AccentDownColor">#2569B0</Color>
    <!-- The accent as TEXT on a dark plate: the fill value has nowhere near the contrast for a glyph. -->
    <Color x:Key="AccentTextColor">#7FB6EE</Color>

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHot" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="AccentDown" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="AccentText" Color="{StaticResource AccentTextColor}" />

    <!-- A selected row, tile or cell: the accent at a low alpha, so the row's own text still reads. -->
    <SolidColorBrush x:Key="SelectionFill" Color="#382D7DD2" />
    <!-- A run of selected characters inside a text box. -->
    <SolidColorBrush x:Key="SelectionText" Color="#552D7DD2" />

    <!-- ══════════════════════════════ Status ══════════════════════════════
         Four states and one colour each. The scheme used to carry three greens and four ambers for the same
         two meanings (a service is up / something needs looking at), which is how a status dot stops being
         readable at a glance. -->

    <SolidColorBrush x:Key="StatusOk" Color="#60C060" />
    <SolidColorBrush x:Key="StatusWarn" Color="#D9903A" />
    <SolidColorBrush x:Key="StatusError" Color="#E0736B" />
    <SolidColorBrush x:Key="StatusIdle" Color="#808080" />
    <!-- Error as TEXT (a validation message), where the dot value is too dark to read at 11px. -->
    <SolidColorBrush x:Key="StatusErrorText" Color="#FFB4A0" />

    <!-- ══════════════════════════════ Axes ══════════════════════════════
         X/Y/Z, in the viewport's own convention — the Vector3 fields carry the same three colours as the
         gizmo, so a number and the arrow it moves are the same thing. -->

    <SolidColorBrush x:Key="AxisX" Color="#FF6060" />
    <SolidColorBrush x:Key="AxisY" Color="#60C060" />
    <SolidColorBrush x:Key="AxisZ" Color="#6090FF" />

    <!-- ══════════════════════════════ Brand ══════════════════════════════
         Blender's orange, for the one control and the one frame that mean "this is a Blender session". The
         only place a foreign brand colour is the point, which is why it does not share the accent. -->

    <Color x:Key="BlenderColor">#E87D0D</Color>
    <SolidColorBrush x:Key="Blender" Color="{StaticResource BlenderColor}" />
    <SolidColorBrush x:Key="BlenderHot" Color="#F58B1F" />

    <!-- ════════════════════ Pinning the Fluent theme's accent ════════════════════

         The app pins ThemeMode.Dark (App.OnStartup) but the Fluent theme still derives its accent from the
         user's WINDOWS PERSONALISATION COLOUR. Every control left on a stock template — check box, radio
         button, progress bar, slider, the focus underline of a text box, a tab's selection indicator — is
         therefore painted in whatever colour Windows is set to, beside the toolkit's own blue. Measured on a
         default Windows install: #4CC2FF, and it moves with the OS setting.

         Overriding the root key (AccentFillColorDefaultBrush) does NOT fix this: the Fluent dictionary
         resolves the accent into ~70 concrete control keys with StaticResource when it loads, so the leaf
         keys hold their own brushes by then. Verified by dumping the live dictionary. The leaves are what has
         to be overridden, and this dictionary is merged into Application.Resources — where it wins, because
         WPF inserts the theme dictionary at index 0 and later entries take precedence.

         The accent also flips from LIGHT (Fluent's own, which carries black content) to the toolkit's darker
         blue, so every on-accent glyph below is moved from black to white with it. -->

    <!-- Accent fill, at rest -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DatePickerBorderBrushFocused" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DatePickerFocusedBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedBackground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CalendarViewSelectedBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CalendarViewTodayBackground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RatingControlSelectedForeground" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="{StaticResource AccentColor}" />

    <!-- The focus underline is a two-stop gradient: the accent only on the edge that grows. -->
    <LinearGradientBrush x:Key="TextControlBorderBrushFocused" StartPoint="0,0" EndPoint="0,1"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" StartPoint="0,0" EndPoint="0,1"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
        <GradientStop Color="#12FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent fill, under the pointer -->
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentHotColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource AccentHotColor}" />

    <!-- Accent fill, held down -->
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedStrokePressed" Color="{StaticResource AccentDownColor}" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{StaticResource AccentDownColor}" />

    <!-- The accent as text or as a hairline indicator -->
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPressed" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="ThumbRateForeground" Color="{StaticResource AccentTextColor}" />

    <!-- A selected row in a stock list, and a run of selected characters — the toolkit's own selection tints,
         so a Fluent-templated list and the scene tree highlight the same way. -->
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#382D7DD2" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPointerOverThemeBrush" Color="#382D7DD2" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundPressedThemeBrush" Color="#382D7DD2" />
    <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressedThemeBrush" Color="#382D7DD2" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#382D7DD2" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#552D7DD2" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#552D7DD2" />

    <!-- What sits ON the accent. Fluent's accent is light and carries black; the toolkit's is dark and
         carries white — the check mark, the radio dot, the switch knob, an accent button's label. -->
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B0FFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#B0FFFFFF" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundPressed" Color="#B0FFFFFF" />
</ResourceDictionary>
