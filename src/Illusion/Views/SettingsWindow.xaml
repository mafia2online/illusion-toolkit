<Window x:Class="Illusion.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Illusion.Views"
        v:Density.ControlHeight="28"
        Title="Settings"
        Width="840" Height="620" MinWidth="660" MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <!-- The application's one settings surface: a section rail on the left, the section on the right, and no
         OK/Cancel — every edit is applied and saved the moment it is made (the footer says so). A draft layer
         would have to be reconciled with the live keymap the editor is already reading, and would buy nothing:
         there is a Reset for the keys and nothing else here is destructive.
         Background is left unset so the Fluent dark chrome paints it like every other window. -->

    <Window.Resources>
        <!-- Section rail: a recessed left column of text rows beside a chromeless content host. Fully replaces
             the default Fluent tab chrome, which draws a horizontal strip.
             The rail is DARKER than the page, not a white tint over it: a translucent tint reads as "lighter
             than everything else" against the Fluent dark chrome, and it is also at the mercy of whatever is
             behind it. SurfaceInput is the palette's editable-field surface (EditorStyles gives every input
             field the same fill), so the rail and the footer sink while the page floats between them. -->
        <Style x:Key="SectionTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TabStripPlacement" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="184" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource SurfaceInput}"
                                    BorderBrush="{StaticResource EdgeFaint}" BorderThickness="0,0,1,0">
                                <StackPanel IsItemsHost="True" Margin="8,12,8,8" />
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTab" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Height="32" Padding="12,0" Margin="0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionFill}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Explanatory line under a field: dim, wraps, never competes with the control above it. -->
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource DimLabel}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="SectionRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource EdgeFaint}" />
            <Setter Property="Margin" Value="0,20,0,16" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceInput}" BorderBrush="{StaticResource EdgeFaint}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Style="{StaticResource DimLabel}" VerticalAlignment="Center"
                           Text="Changes are saved as you make them" />
                <Button Content="Close" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Grid>
        </Border>

        <TabControl x:Name="Sections" Style="{StaticResource SectionTabControl}">

            <!-- ═══ General ═══ -->
            <TabItem Header="General" Style="{StaticResource SectionTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="Game folder" Style="{StaticResource Caption}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GamePathBox" Grid.Column="0" Style="{StaticResource DarkBox}"
                                     FontFamily="Consolas"
                                     TextChanged="GamePath_TextChanged" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource NeutralButton}"
                                    Margin="8,0,0,0" Click="BrowseGame_Click" />
                        </Grid>
                        <TextBlock x:Name="GamePathStatus" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The Mafia II install — its pc folder or the game root. Everything the toolkit opens is found from here, the headless probes included." />

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="Build" Style="{StaticResource Caption}" />
                        <CheckBox x:Name="BuildNoticeCheck" Foreground="{StaticResource TextPrimary}"
                                  Content="Show a notice after a successful build"
                                  Checked="BuildNotice_Changed" Unchecked="BuildNotice_Changed" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Failures are always reported, whatever this is set to" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Updates ═══ -->
            <TabItem Header="Updates" Style="{StaticResource SectionTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="This build" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas"
                                   FontSize="13" />
                        <TextBlock x:Name="BuildText" Style="{StaticResource Hint}" />

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="Checking" Style="{StaticResource Caption}" />
                        <CheckBox x:Name="UpdateStartupCheck" Foreground="{StaticResource TextPrimary}"
                                  Content="Look for a newer version when the toolkit starts"
                                  Checked="UpdateStartup_Changed" Unchecked="UpdateStartup_Changed" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="One request to the GitHub releases page, in the background, with no account involved. It can only ever add the download button beside the launcher's gear — a check that fails says nothing and changes nothing." />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="CheckUpdateBtn" Content="Check now"
                                    Style="{StaticResource NeutralButton}" Click="CheckUpdate_Click" />
                            <Button x:Name="InstallUpdateBtn" Content="Download and install"
                                    Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="InstallUpdate_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" />

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="Releases" Style="{StaticResource Caption}" />
                        <Button Content="Open the releases page"
                                Style="{StaticResource NeutralButton}" HorizontalAlignment="Left"
                                Click="ReleasesPage_Click" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Every version, its notes and its archive. Installing by hand is unpacking one over this folder — nothing here writes anywhere else, and your settings live outside it." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ Keymap ═══ -->
            <TabItem Header="Keymap" Style="{StaticResource SectionTab}">
                <DockPanel Margin="20,16,20,16">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Search with a magnifier and a placeholder, like the scene panel's: an empty box
                             with nothing in or next to it does not say what it is for. -->
                        <Grid Grid.Column="0">
                            <TextBox x:Name="KeymapSearch" Style="{StaticResource DarkBox}"
                                     Padding="28,0,8,0" ToolTip="Filter by action or by key"
                                     TextChanged="KeymapSearch_TextChanged" />
                            <Path Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                                  Fill="Transparent" Stroke="{StaticResource TextMuted}" StrokeThickness="1.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="{StaticResource BrowserFind}" />
                            <TextBlock x:Name="KeymapSearchPlaceholder" Text="Search actions or keys"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" Margin="28,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="ResetAllKeysBtn" Grid.Column="1" Content="Restore defaults"
                                Style="{StaticResource NeutralButton}" Margin="8,0,0,0"
                                Click="ResetAllKeys_Click" />
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Click a key to record a new one, then press it — click anywhere else to leave it alone. The cross unbinds the action, the arrow puts back the key it shipped with. Keys may repeat across groups: the editor's Scale and the camera's Back are both S because the two are never listening at the same time." />

                    <!-- Right margin: the scroll bar gets its own lane instead of sitting on the row buttons. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="KeymapList" Margin="0,0,16,0" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ═══ Blender bridge ═══ -->
            <TabItem Header="Blender bridge" Style="{StaticResource SectionTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="Blender" Style="{StaticResource Caption}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BlenderPathBox" Grid.Column="0" Style="{StaticResource DarkBox}"
                                     FontFamily="Consolas"
                                     TextChanged="BlenderPath_TextChanged" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource NeutralButton}"
                                    Margin="8,0,0,0" Click="BrowseBlender_Click" />
                        </Grid>
                        <TextBlock x:Name="BlenderPathStatus" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Leave it empty to let the bridge find Blender itself: the .blend file association, then Program Files, then Steam, then PATH. Blender 4.2 or newer." />

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="Edit mode" Style="{StaticResource Caption}" />
                        <CheckBox x:Name="AutoPushCheck" Foreground="{StaticResource TextPrimary}"
                                  Content="Push edits back automatically when leaving Edit Mode"
                                  Checked="AutoPush_Changed" Unchecked="AutoPush_Changed" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The addon's own N-panel toggle mirrors this. Its push button always works, whether this is on or not." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══ MCP server ═══ -->
            <TabItem Header="MCP server" Style="{StaticResource SectionTab}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="Port" Style="{StaticResource Caption}" />
                        <TextBox x:Name="McpPortBox" Style="{StaticResource DarkBox}" Width="120"
                                 HorizontalAlignment="Left" FontFamily="Consolas"
                                 TextChanged="McpPort_TextChanged" />
                        <TextBlock x:Name="McpPortStatus" Style="{StaticResource Hint}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The loopback port the embedded MCP server listens on. Worth changing only if something else on this machine already owns the default. The server binds at startup, so a new port is taken up the next time the toolkit runs." />

                        <Border Style="{StaticResource SectionRule}" />

                        <TextBlock Text="Right now" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="McpLiveState" Foreground="{StaticResource TextPrimary}" FontFamily="Consolas"
                                   FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
